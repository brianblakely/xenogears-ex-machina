/* Members of C data tables that the remaining assembly addresses by their
 * own symbols. splat lists only the unaligned ones in undefined_syms_auto.txt;
 * these are word-aligned. */
D_800ADEDC = D_800ADE9C + 0x40; /* 8007e1c0: choice cursor frame x */
D_800ADEE0 = D_800ADE9C + 0x44; /* 8007e1c0: choice cursor frame w */
D_800ADF04 = D_800ADE9C + 0x68; /* 8007e1c0: prompt frame x */
D_800ADF08 = D_800ADE9C + 0x6C; /* 8007e1c0: prompt frame w */
D_800AEB6C = D_800AEB68 + 4;    /* 800a8ba4: panel frame w */
