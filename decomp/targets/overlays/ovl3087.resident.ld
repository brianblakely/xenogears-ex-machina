/* Resident and battle overlay symbols the ovl3087 source addresses from
 * their base, where the generated undefined-symbol list only names the
 * accessed fields. */
D_8006D634 = 0x8006D634; /* game data */
D_8006F9DC = 0x8006F9DC; /* the battle's formation (its script set at +3) */
D_800CCB04 = 0x800CCB04; /* battle drawing state */
D_800CCCE8 = 0x800CCCE8; /* battle combatant records (0x170 each) */
D_800D32A0 = 0x800D32A0; /* battle per-slot flags (8 bytes each) */
