// Shared app Settings, with sidebar navigation and a compact section picker.
import { AboutSlint, Button, CheckBox, ComboBox, GroupBox, LineEdit, Palette, ScrollView, Slider, SpinBox, TabWidget } from "std-widgets.slint";

export component SettingsPanel inherits Window {
    in-out property <float> master-volume;
    in-out property <int> audio-output;
    in-out property <int> scale;
    in-out property <int> filter;
    in-out property <bool> show-fps;
    // Graphics (xem_settings::Graphics): indexes into the models below.
    // 0 Original (the console's picture), 1 Ex Machina's renderer.
    in-out property <int> gfx-renderer: 1;
    in-out property <int> gfx-profile;
    in-out property <int> gfx-scale;
    in-out property <int> gfx-quality;
    in-out property <int> gfx-rate;
    in-out property <bool> gfx-interpolation;
    in-out property <bool> gfx-widescreen;
    // The field camera pulled back, percent (100-500).
    in-out property <int> gfx-zoom-out: 100;
    in-out property <bool> gfx-actors-in-view: true;
    in-out property <int> gfx-filter-world;
    in-out property <int> gfx-filter-sprites;
    in-out property <int> gfx-filter-interface;
    in-out property <int> gfx-filter-movies;
    in-out property <bool> gfx-cull-back-faces;
    in-out property <bool> gfx-cull-viewport;
    // Custom profile limits, in the order of fidelity-names.
    in-out property <[bool]> gfx-fidelity;
    // Effect levels of the selected profile (HD-2D or Custom), in the order of effect-names.
    in-out property <[int]> gfx-effects;
    in-out property <int> gfx-xr-distance;
    in-out property <int> gfx-xr-width;
    in-out property <bool> gfx-xr-dof;
    in property <string> gfx-status;
    private property <[string]> fidelity-names: ["Affine textures", "Vertex snapping", "15-bit colour", "Dithering", "Native resolution", "Painter's ordering"];
    private property <[string]> effect-names: ["Lighting", "Shadows", "Ambient occlusion", "Fog", "Light shafts", "Bloom", "Colour grading", "Depth of field", "Focus"];
    in-out property <bool> pause-on-focus-loss;
    in property <string> status;
    in property <bool> can-import-disc;
    in property <string> disc-status: "No disc imported";
    in property <[string]> app-actions;
    in-out property <int> selected-action;
    in-out property <string> keyboard-binding;
    in-out property <string> gamepad-binding;
    in property <[string]> backup-actions;
    in-out property <int> selected-backup;
    in-out property <int> selected-section: 0;
    in property <bool> wide-layout;
    private property <[string]> sections: ["Audio", "Graphics", "Controls", "Time", "Saves"];
    in property <string> time-status: "Boot a game to use rewind.";
    in property <string> storage-status;
    in property <bool> fast-forward;
    in property <int> fast-forward-rate;
    in property <[string]> fast-forward-rates;
    in-out property <float> fast-forward-position;
    in-out property <bool> invert-trigger-chords;
    in-out property <bool> rewind-enabled;
    in-out property <int> rewind-interval-seconds;
    in property <int> rewind-interval-max;
    in-out property <int> rewind-history-seconds;
    in property <int> rewind-history-max;
    private property <bool> keyboard-editor-focused;
    private property <bool> gamepad-editor-focused;
    private property <bool> rewind-interval-focused;
    private property <bool> rewind-history-focused;
    out property <bool> text-editor-focused: keyboard-editor-focused || gamepad-editor-focused || rewind-interval-focused || rewind-history-focused;
    callback action-selected(int);
    callback binding-edited(int, string, string);
    callback app-action-requested(int);
    callback backup-action-requested(int);
    callback fast-forward-rate-edited(int);
    callback invert-trigger-chords-edited(bool);
    callback rewind-enabled-edited(bool);
    callback rewind-interval-edited(int);
    callback rewind-history-edited(int);
    callback rewind-held(bool);
    callback master-volume-edited(int);
    callback audio-output-edited(int);
    callback scale-edited(int);
    callback filter-edited(int);
    callback show-fps-edited(bool);
    // A graphics choice by name (renderer, profile, scale, quality, rate, interpolation,
    // widescreen, zoom-out, filter-world, filter-sprites, filter-interface,
    // cull, cull-viewport, xr-distance, xr-width, xr-dof) and value.
    callback graphics-edited(string, int);
    callback fidelity-edited(int, bool);
    callback effect-edited(int, int);
    callback pause-on-focus-loss-edited(bool);
    callback close-requested();
    callback import-disc-requested();

    changed selected-section => {
        section-scroll.content-y = 0px;
        root.keyboard-editor-focused = false;
        root.gamepad-editor-focused = false;
        root.rewind-interval-focused = false;
        root.rewind-history-focused = false;
        root.rewind-held(false);
    }

    title: "Settings";
    background: transparent;
    preferred-width: 640px;
    preferred-height: 560px;
    min-width: 280px;
    min-height: 280px;

    Rectangle {
        background: Palette.background.with-alpha(0.96);
        border-radius: 12px;
        border-width: 1px;
        border-color: Palette.border;
        VerticalLayout {
            padding: 16px;
            padding-right: 8px;
            spacing: 12px;
            HorizontalLayout {
                padding-right: 8px;
                Text { text: "Settings"; font-size: 20px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "Close"; horizontal-stretch: 0; preferred-width: 72px; clicked => { root.close-requested(); } }
            }
            HorizontalLayout {
                spacing: 12px;
                if root.wide-layout: VerticalLayout {
                    min-width: 104px;
                    max-width: 104px;
                    horizontal-stretch: 0;
                    TabWidget {
                        orientation: Orientation.vertical;
                        current-index <=> root.selected-section;
                        min-height: 200px;
                        max-height: 200px;
                        // The tab bar navigates the single shared content view.
                        Tab { title: root.sections[0]; Rectangle { accessible-role: none; } }
                        Tab { title: root.sections[1]; Rectangle { accessible-role: none; } }
                        Tab { title: root.sections[2]; Rectangle { accessible-role: none; } }
                        Tab { title: root.sections[3]; Rectangle { accessible-role: none; } }
                        Tab { title: root.sections[4]; Rectangle { accessible-role: none; } }
                    }
                    Rectangle { accessible-role: none; vertical-stretch: 1; }
                }
                VerticalLayout {
                    spacing: 12px;
                    if !root.wide-layout: ComboBox {
                        accessible-label: "Settings section";
                        model: root.sections;
                        current-index <=> root.selected-section;
                    }
                    section-scroll := ScrollView {
                        accessible-role: tab-panel;
                        accessible-label: root.sections[root.selected-section];
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        // Compact touch hosts pan the form; desktop mouse
                        // presses reach sliders immediately without a pan delay.
                        mouse-drag-pan-enabled: !root.wide-layout;
                        content-width: self.visible-width;
                        VerticalLayout {
                            spacing: 12px;
                            alignment: start;
                            // Reserve a gutter for the scrollbar at the outer edge.
                            padding-right: 20px;
                            if root.selected-section == 0: GroupBox {
                                title: "Audio";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Master volume"; vertical-alignment: center; horizontal-stretch: 0; }
                                        Slider { accessible-label: "Master volume"; minimum: 0; maximum: 100; value <=> root.master-volume; changed(value) => { root.master-volume-edited(round(value)); } }
                                        Text { text: round(root.master-volume); vertical-alignment: center; min-width: 28px; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Output"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Audio output"; model: ["Mono", "Stereo", "Wide"]; current-index <=> root.audio-output; selected => { root.audio-output-edited(self.current-index); } }
                                    }
                                }
                            }
                            if root.selected-section == 1: GroupBox {
                                title: "Graphics";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Renderer"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Renderer"; model: ["Original", "Ex Machina"]; current-index <=> root.gfx-renderer; selected => { root.graphics-edited("renderer", self.current-index); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Scale"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Scale"; model: ["Fit", "Integer", "Stretch"]; current-index <=> root.scale; selected => { root.scale-edited(self.current-index); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Filter"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Filter"; model: ["Nearest", "Linear"]; current-index <=> root.filter; selected => { root.filter-edited(self.current-index); } }
                                    }
                                    CheckBox { text: "Show FPS"; checked <=> root.show-fps; toggled => { root.show-fps-edited(self.checked); } }
                                }
                            }
                            if root.selected-section == 1 && root.gfx-renderer == 1: GroupBox {
                                title: "Profile";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Look"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Graphics profile"; model: ["Modern", "HD-2D", "PS1", "Custom"]; current-index <=> root.gfx-profile; selected => { root.graphics-edited("profile", self.current-index); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Resolution"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Internal resolution"; model: ["Auto", "1x", "2x", "3x", "4x", "5x", "6x", "7x", "8x"]; current-index <=> root.gfx-scale; selected => { root.graphics-edited("scale", self.current-index); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Quality"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Effects quality tier"; model: ["Auto", "Low", "Medium", "High", "Ultra"]; current-index <=> root.gfx-quality; selected => { root.graphics-edited("quality", self.current-index); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Present"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Presentation rate"; model: ["Every display refresh", "Game frames only"]; current-index <=> root.gfx-rate; selected => { root.graphics-edited("rate", self.current-index); } }
                                    }
                                    CheckBox { text: "Interpolate motion (one frame later)"; checked <=> root.gfx-interpolation; toggled => { root.graphics-edited("interpolation", self.checked ? 1 : 0); } }
                                    CheckBox { text: "Wider framing (to the window's shape)"; checked <=> root.gfx-widescreen; toggled => { root.graphics-edited("widescreen", self.checked ? 1 : 0); } }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Zoom out"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        Text { text: "1x"; vertical-alignment: center; horizontal-stretch: 0; }
                                        Slider {
                                            accessible-label: "Field camera zoom out (mouse wheel)";
                                            minimum: 100;
                                            maximum: 500;
                                            value: root.gfx-zoom-out;
                                            changed(value) => { root.graphics-edited("zoom-out", round(value / 25) * 25); }
                                        }
                                        Text { text: "5x"; vertical-alignment: center; horizontal-stretch: 0; }
                                        Text { text: "\{root.gfx-zoom-out / 100}x"; vertical-alignment: center; min-width: 40px; horizontal-stretch: 0; }
                                    }
                                    CheckBox { text: "Characters keep moving in the wider view (changes gameplay)"; checked <=> root.gfx-actors-in-view; toggled => { root.graphics-edited("actors-in-view", self.checked ? 1 : 0); } }
                                    Text { text: root.gfx-status; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                }
                            }
                            if root.selected-section == 1 && root.gfx-renderer == 1 && (root.gfx-profile == 1 || root.gfx-profile == 3): GroupBox {
                                title: "HD-2D effects";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 6px;
                                    for name[index] in root.effect-names: HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: name; vertical-alignment: center; min-width: 120px; horizontal-stretch: 0; }
                                        Slider {
                                            accessible-label: name;
                                            minimum: index == 8 ? -100 : 0;
                                            maximum: 100;
                                            value: root.gfx-effects[index];
                                            released(value) => { root.effect-edited(index, round(value)); }
                                        }
                                        Text { text: root.gfx-effects[index]; vertical-alignment: center; min-width: 32px; horizontal-stretch: 0; }
                                    }
                                }
                            }
                            if root.selected-section == 1 && root.gfx-renderer == 1 && root.gfx-profile == 3: GroupBox {
                                title: "Original limits";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 6px;
                                    for name[index] in root.fidelity-names: CheckBox {
                                        text: name;
                                        checked: root.gfx-fidelity[index];
                                        toggled => { root.fidelity-edited(index, self.checked); }
                                    }
                                }
                            }
                            if root.selected-section == 1 && root.gfx-renderer == 1: GroupBox {
                                title: "Texture filtering and culling";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "World"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "World filtering"; model: ["Nearest", "Linear"]; current-index <=> root.gfx-filter-world; selected => { root.graphics-edited("filter-world", self.current-index); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Sprites"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Sprite filtering"; model: ["Nearest", "Linear"]; current-index <=> root.gfx-filter-sprites; selected => { root.graphics-edited("filter-sprites", self.current-index); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Interface"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Interface filtering"; model: ["Nearest", "Linear"]; current-index <=> root.gfx-filter-interface; selected => { root.graphics-edited("filter-interface", self.current-index); } }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Movies"; vertical-alignment: center; min-width: 90px; horizontal-stretch: 0; }
                                        ComboBox { accessible-label: "Movie filtering"; model: ["Bicubic", "Nearest"]; current-index <=> root.gfx-filter-movies; selected => { root.graphics-edited("filter-movies", self.current-index); } }
                                    }
                                    CheckBox { text: "Cull back faces (off: as the game draws)"; checked <=> root.gfx-cull-back-faces; toggled => { root.graphics-edited("cull", self.checked ? 1 : 0); } }
                                    CheckBox { text: "Cull at the original screen's edges (off: wider and zoomed-out views show the scenery the game culled)"; checked <=> root.gfx-cull-viewport; toggled => { root.graphics-edited("cull-viewport", self.checked ? 1 : 0); } }
                                }
                            }
                            if root.selected-section == 1: GroupBox {
                                title: "Headset screen";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Distance"; vertical-alignment: center; horizontal-stretch: 1; }
                                        SpinBox { accessible-label: "Headset screen distance in centimetres"; min-width: 104px; max-width: 104px; horizontal-stretch: 0; minimum: 50; maximum: 2000; step-size: 10; value <=> root.gfx-xr-distance; edited(value) => { root.graphics-edited("xr-distance", value); } }
                                        Text { text: "cm"; vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Width"; vertical-alignment: center; horizontal-stretch: 1; }
                                        SpinBox { accessible-label: "Headset screen width in centimetres"; min-width: 104px; max-width: 104px; horizontal-stretch: 0; minimum: 50; maximum: 2000; step-size: 10; value <=> root.gfx-xr-width; edited(value) => { root.graphics-edited("xr-width", value); } }
                                        Text { text: "cm"; vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                    if root.gfx-renderer == 1: CheckBox { text: "Depth of field in the headset"; checked <=> root.gfx-xr-dof; toggled => { root.graphics-edited("xr-dof", self.checked ? 1 : 0); } }
                                }
                            }
                            if root.selected-section == 2: GroupBox {
                                title: "Controls";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 10px;
                                    CheckBox { text: "Invert LT/RT chords"; checked <=> root.invert-trigger-chords; toggled => { root.invert-trigger-chords-edited(self.checked); } }
                                    Text { text: root.invert-trigger-chords ? "LT: hold to rewind · RT: toggle fast-forward\nBack+LT/RT: game L2/R2" : "Back+LT: hold to rewind · Back+RT: toggle fast-forward\nLT/RT: game L2/R2"; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                    ComboBox { accessible-label: "App operation"; model: root.app-actions; current-index <=> root.selected-action; selected => { root.action-selected(self.current-index); } }
                                    Text { text: "Keyboard binding"; }
                                    LineEdit {
                                        accessible-label: "Keyboard binding";
                                        placeholder-text: "F5 or ControlLeft+KeyS";
                                        text <=> root.keyboard-binding;
                                        changed has-focus => { root.keyboard-editor-focused = self.has-focus; }
                                    }
                                    Text { text: "Gamepad binding"; }
                                    LineEdit {
                                        accessible-label: "Gamepad binding";
                                        placeholder-text: "Back+South";
                                        text <=> root.gamepad-binding;
                                        changed has-focus => { root.gamepad-editor-focused = self.has-focus; }
                                    }
                                    Button { text: "Save binding"; clicked => { root.binding-edited(root.selected-action, root.keyboard-binding, root.gamepad-binding); } }
                                }
                            }
                            if root.selected-section == 3: GroupBox {
                                title: "Rewind";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 8px;
                                    CheckBox { text: "Enable rewind history"; checked <=> root.rewind-enabled; toggled => { root.rewind-enabled-edited(self.checked); } }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "Interval"; vertical-alignment: center; horizontal-stretch: 1; }
                                        SpinBox {
                                            accessible-label: "Rewind interval in seconds";
                                            min-width: 104px;
                                            max-width: 104px;
                                            horizontal-stretch: 0;
                                            minimum: 1;
                                            maximum: min(root.rewind-interval-max, root.rewind-history-seconds);
                                            value <=> root.rewind-interval-seconds;
                                            edited(value) => { root.rewind-interval-edited(value); }
                                            changed has-focus => { root.rewind-interval-focused = self.has-focus; }
                                        }
                                        Text { text: "seconds"; vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "History length"; vertical-alignment: center; horizontal-stretch: 1; }
                                        SpinBox {
                                            accessible-label: "Rewind history length in seconds";
                                            min-width: 104px;
                                            max-width: 104px;
                                            horizontal-stretch: 0;
                                            minimum: root.rewind-interval-seconds;
                                            maximum: root.rewind-history-max;
                                            value <=> root.rewind-history-seconds;
                                            edited(value) => { root.rewind-history-edited(value); }
                                            changed has-focus => { root.rewind-history-focused = self.has-focus; }
                                        }
                                        Text { text: "seconds"; vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                    Text { text: "Snapshots use elapsed play time, including during fast-forward."; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                    Text { text: root.time-status; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                    Button { text: "Hold to rewind"; changed pressed => { root.rewind-held(self.pressed); } }
                                }
                            }
                            if root.selected-section == 3: GroupBox {
                                title: "Fast-forward";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 8px;
                                    HorizontalLayout {
                                        Text { text: "Speed"; vertical-alignment: center; horizontal-stretch: 1; }
                                        Text { text: root.fast-forward-rates[root.fast-forward-rate]; vertical-alignment: center; horizontal-stretch: 0; }
                                    }
                                    Slider {
                                        accessible-label: "Fast-forward rate";
                                        minimum: 0;
                                        maximum: root.fast-forward-rates.length - 1;
                                        step: 1;
                                        value <=> root.fast-forward-position;
                                        changed(value) => { root.fast-forward-position = round(value); if round(value) != root.fast-forward-rate { root.fast-forward-rate-edited(round(value)); } }
                                    }
                                    Rectangle {
                                        height: 7px;
                                        for index in root.fast-forward-rates.length: Rectangle {
                                            x: 10px + index * (parent.width - 20px) / (root.fast-forward-rates.length - 1) - 0.5px;
                                            width: 1px;
                                            height: index == root.fast-forward-rate ? 7px : 4px;
                                            background: Palette.foreground.with-alpha(index == root.fast-forward-rate ? 0.9 : 0.4);
                                        }
                                    }
                                    Rectangle {
                                        height: self.width < 380px ? 36px : 18px;
                                        for label[index] in root.fast-forward-rates: Text {
                                            width: label == "Uncapped" ? 58px : 30px;
                                            height: 18px;
                                            y: parent.width < 380px ? (index - 2 * floor(index / 2)) * 18px : 0px;
                                            x: clamp(10px + index * (parent.width - 20px) / (root.fast-forward-rates.length - 1) - self.width / 2, 0px, parent.width - self.width);
                                            text: label;
                                            horizontal-alignment: center;
                                            font-size: 11px;
                                        }
                                    }
                                    Text { text: root.fast-forward ? "Fast-forward is on. Toggle it with its binding." : "Toggle fast-forward with its binding."; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                    Text { text: "Music stays at normal tempo and pitch."; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                }
                            }
                            if root.selected-section == 3: GroupBox {
                                title: "Pause";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 8px;
                                    CheckBox { text: "Pause when window loses focus"; checked <=> root.pause-on-focus-loss; toggled => { root.pause-on-focus-loss-edited(self.checked); } }
                                    Text { text: "Uses the game’s pause screen when pausing is allowed. Resume with Start after refocusing."; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                }
                            }
                            if root.selected-section == 4: GroupBox {
                                title: "Save states";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 10px;
                                    Text { text: "Save states capture game progress. App settings stay as currently set."; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Button { text: "Save state"; clicked => { root.app-action-requested(0); } }
                                        Button { text: "Load state"; clicked => { root.app-action-requested(1); } }
                                    }
                                    ComboBox { accessible-label: "Backup operation"; model: root.backup-actions; current-index <=> root.selected-backup; }
                                    Button { text: "Run backup operation"; clicked => { root.backup-action-requested(root.selected-backup); } }
                                    Text { text: root.storage-status; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                                }
                            }
                            if root.selected-section == 4 && root.can-import-disc: GroupBox {
                                title: "Game disc";
                                vertical-stretch: 0;
                                VerticalLayout {
                                    spacing: 8px;
                                    Text { text: root.disc-status; wrap: word-wrap; }
                                    Button { text: "Import disc…"; clicked => { root.import-disc-requested(); } }
                                }
                            }
                            if root.selected-section == 4: AboutSlint { max-height: 120px; }
                            Rectangle { accessible-role: none; vertical-stretch: 1; }
                        }
                    }
                }
            }
            Text { text: root.status; color: Palette.foreground.with-alpha(0.7); wrap: word-wrap; }
        }
    }
}

export component FrameRateOverlay inherits Window {
    in property <string> counter: "— FPS";
    background: transparent;
    preferred-width: 96px;
    preferred-height: 28px;
    Rectangle {
        background: #101114d9;
        border-radius: 5px;
        Text {
            text: root.counter;
            color: #f5f5f5;
            font-family: "monospace";
            font-size: 14px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
