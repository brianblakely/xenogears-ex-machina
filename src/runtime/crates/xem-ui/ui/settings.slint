// The app's Settings: sections in a sidebar (a strip of icons when the panel
// is narrow), each a column of cards of rows (some under a heading), under a
// header with Quit (on hosts that can quit) and Close and over an error bar
// while something failed. An ordinary
// application style (plan.md: not Seraph Glass) on Slint's fluent-dark
// widgets; every edit goes through the settings service (lib.rs), and the
// panel shows what it acknowledged.
import { AboutSlint, Button, LineEdit, Palette, ScrollView, Slider, SpinBox, Switch } from "std-widgets.slint";

/// An app operation and its bindings, as the Shortcuts section lists them.
export struct BindingRow {
    name: string,
    keyboard: string,
    gamepad: string,
}

struct Section {
    label: string,
    icon: string,
}

global Theme {
    out property <brush> panel: #15171cf7;
    out property <brush> raised: #ffffff08;
    out property <brush> hover: #ffffff0f;
    out property <brush> pressed: #ffffff1a;
    out property <brush> selected: #ffffff17;
    out property <brush> selected-hover: #ffffff1f;
    out property <brush> stroke: #ffffff17;
    out property <brush> divider: #ffffff10;
    out property <brush> well: #00000033;
    out property <brush> text: #ffffffeb;
    out property <brush> text-secondary: #ffffffa8;
    out property <brush> text-tertiary: #ffffff73;
    out property <brush> accent: Palette.accent-background;
    out property <brush> good: #8fd9a8;
    out property <brush> bad: #ffa3a3;
}

// Icons on a 24-unit grid.
global Icons {
    out property <string> audio: "M4 9.5 L8 9.5 L13 5.5 L13 18.5 L8 14.5 L4 14.5 Z M16.4 9.2 A4 4 0 0 1 16.4 14.8 M18.8 6.8 A7.4 7.4 0 0 1 18.8 17.2";
    out property <string> graphics: "M3.5 5 L20.5 5 L20.5 16 L3.5 16 Z M8.5 20 L15.5 20 M12 16 L12 20";
    out property <string> shortcuts: "M5 6.5 L19 6.5 A2 2 0 0 1 21 8.5 L21 15.5 A2 2 0 0 1 19 17.5 L5 17.5 A2 2 0 0 1 3 15.5 L3 8.5 A2 2 0 0 1 5 6.5 Z M7 10 L7.1 10 M10.3 10 L10.4 10 M13.6 10 L13.7 10 M16.9 10 L17 10 M8 14 L16 14";
    out property <string> controls: "M7 8 L17 8 A4.5 4.5 0 0 1 21.5 12.5 L21.5 14 A2.8 2.8 0 0 1 16.6 15.8 L15.4 14.5 L8.6 14.5 L7.4 15.8 A2.8 2.8 0 0 1 2.5 14 L2.5 12.5 A4.5 4.5 0 0 1 7 8 Z M7.5 9.8 L7.5 12.8 M6 11.3 L9 11.3 M15.8 10.2 L15.8 10.3 M17.6 12.2 L17.6 12.3";
    out property <string> bug: "M9 8 L9 6 A3 3 0 0 1 15 6 L15 8 M9 5 L7 3 M15 5 L17 3 M7 8 L17 8 L17 15 A5 5 0 0 1 7 15 Z M12 8 L12 20 M7 10 L4 8 M17 10 L20 8 M7 14 L3 14 M17 14 L21 14 M7.7 18 L4 20 M16.3 18 L20 20";
    out property <string> time: "M12 3.5 A8.5 8.5 0 1 1 11.99 3.5 Z M12 7.5 L12 12 L15 14";
    out property <string> saves: "M5 4 L15.5 4 L20 8.5 L20 20 L5 20 Z M8 4 L8 8.5 L15 8.5 L15 4 M8 20 L8 13.5 L17 13.5 L17 20";
    // Filled Xenogears silhouette from the reference, with subpixel brush noise removed.
    // It uses more of the grid so the flared cap remains legible at 18px.
    out property <string> gameplay: "M7.5 1.66 C7.34 1.76 7.12 1.83 7.03 1.84 C6.8 1.84 6.41 2.14 6.41 2.32 C6.41 2.62 6.76 3.05 8.34 4.67 C10.06 6.46 10.24 6.71 10.07 7.29 C10.03 7.42 10.04 7.91 10.1 8.39 L10.19 9.26 L9.83 9.98 C9.54 10.54 9.41 10.72 9.25 10.76 C9.07 10.79 9.04 10.84 9.04 11.09 C9.04 11.72 8.8 12.5 8.63 12.5 C8.29 12.5 7.61 14.1 7.71 14.66 C7.78 15.04 7.43 15.27 7.09 15.03 C6.82 14.85 6.62 15.22 6.65 15.86 C6.68 16.48 6.13 18.31 5.89 18.38 C5.42 18.53 5.02 20.71 5.34 21.41 C5.98 22.8 7.64 22.9 8.03 21.55 C8.1 21.32 8.27 20.96 8.39 20.75 C8.52 20.54 8.76 20.11 8.92 19.79 C9.07 19.47 9.33 19.01 9.48 18.78 C9.63 18.53 9.79 18.19 9.85 18.02 C9.89 17.85 9.98 17.65 10.03 17.59 C10.23 17.36 10.65 16.55 10.75 16.21 C10.81 16.04 10.95 15.7 11.05 15.49 C11.23 15.13 11.39 14.75 11.79 13.66 C12 13.1 12.57 12.01 12.75 11.82 C12.83 11.72 12.92 11.56 12.92 11.46 C12.92 10.73 13.4 11.11 14.21 12.48 C15.1 14 15.3 14.32 15.47 14.54 C15.79 14.98 16 15.51 16 15.98 C16 16.33 16.04 16.42 16.15 16.46 C16.25 16.48 16.5 16.74 16.73 17.02 C17 17.36 17.26 17.59 17.53 17.71 L17.94 17.9 L18.43 17.66 C18.7 17.52 18.92 17.36 18.91 17.31 C18.89 16.9 18.66 15.97 18.54 15.84 C18.48 15.76 18.36 15.43 18.3 15.12 C18.11 14.15 17.59 13.28 17.1 13.13 C16.91 13.06 16.75 12.69 16.75 12.27 C16.75 11.89 16.46 11.29 16.2 11.11 C16.02 11 15.65 10.54 15.22 9.92 C15.13 9.77 15.09 9.62 15.12 9.42 C15.19 9 14.99 8.62 14.68 8.56 C14.17 8.45 14.03 7.74 14.25 6.5 C14.3 6.2 14.34 5.81 14.34 5.63 C14.33 5.42 14.44 5.12 14.58 4.81 C14.73 4.53 14.83 4.22 14.83 4.11 C14.83 3.96 14.89 3.9 15.07 3.88 C16.25 3.63 15.83 2.94 14.24 2.5 C13.03 2.18 12.16 2.74 12.16 3.87 C12.16 3.97 12.09 4.15 12.01 4.25 L11.84 4.46 L11.36 4 C10.81 3.46 9.94 2.75 9.83 2.75 C9.79 2.75 9.61 2.62 9.42 2.46 C9.22 2.3 9.01 2.17 8.96 2.17 C8.9 2.17 8.72 2.06 8.57 1.92 C8.03 1.47 7.92 1.44 7.5 1.66 Z";
    out property <string> about: "M12 3.5 A8.5 8.5 0 1 1 11.99 3.5 Z M12 11 L12 16.5 M12 7.6 L12 7.7";
    out property <string> close: "M6.5 6.5 L17.5 17.5 M17.5 6.5 L6.5 17.5";
    out property <string> reset: "M19.5 8 A8 8 0 1 0 20 15 M19.5 3.5 L19.5 8.5 L14.5 8.5";
    out property <string> power: "M12 3.5 L12 11.5 M6.7 7.7 A7.5 7.5 0 1 0 17.3 7.7";
    out property <string> check: "M5 12.5 L10 17 L19 7.5";
    out property <string> alert: "M12 3.5 A8.5 8.5 0 1 1 11.99 3.5 Z M12 7.8 L12 12.6 M12 16 L12 16.1";
    out property <string> emblem: "M12 2.6 L20.2 7.3 L20.2 16.7 L12 21.4 L3.8 16.7 L3.8 7.3 Z M12 8.4 A3.6 3.6 0 1 1 11.99 8.4 Z";
}

component Icon inherits Path {
    in property <string> data;
    in property <brush> color: Theme.text-secondary;
    in property <bool> filled;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.data;
    stroke: root.filled ? transparent : root.color;
    stroke-width: root.filled ? 0px : 1.7px;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: root.filled ? root.color : transparent;
    accessible-role: none;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

// A section in the navigation: a row in the sidebar, or a stacked icon and
// label in the narrow panel's strip.
component NavItem inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> selected;
    in property <bool> stacked;
    callback activated();

    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.activated(); }
    private property <bool> hovered: touch.has-hover;
    private property <brush> label-color: root.selected || root.hovered ? Theme.text : Theme.text-secondary;
    private property <brush> icon-color: root.selected ? Theme.accent : root.hovered ? Theme.text : Theme.text-secondary;
    min-height: root.stacked ? 54px : 38px;
    max-height: root.stacked ? 54px : 38px;
    // A tab in the strip would be as wide as its label, bold as when
    // selected, and shares out any room left; a strip too narrow for that
    // takes the same from every tab (their labels elide), down to a tab
    // just wider than its icon, so every tab stays inside the panel.
    min-width: root.stacked ? 24px : 0px;
    preferred-width: root.stacked ? label-size.preferred-width + 6px : 0px;
    label-size := Text { text: root.label; font-size: 10.5px; font-weight: 600; visible: false; accessible-role: none; }
    border-radius: 8px;
    background: touch.pressed ? Theme.pressed : root.selected ? (root.hovered ? Theme.selected-hover : Theme.selected) : root.hovered ? Theme.hover : transparent;
    animate background { duration: 140ms; easing: ease-out; }

    Rectangle {
        background: Theme.accent;
        border-radius: 1.5px;
        width: root.stacked ? (root.selected ? 18px : 0px) : 3px;
        height: root.stacked ? 3px : (root.selected ? 16px : 0px);
        x: root.stacked ? (parent.width - self.width) / 2 : 0px;
        y: root.stacked ? parent.height - self.height - 2px : (parent.height - self.height) / 2;
        animate width, height { duration: 160ms; easing: ease-out; }
    }
    if !root.stacked: HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { data: root.icon; color: root.icon-color; filled: root.icon == Icons.gameplay; }
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            color: root.label-color;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: 140ms; }
        }
    }
    if root.stacked: VerticalLayout {
        padding-top: 7px;
        padding-bottom: 9px;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Icon { data: root.icon; color: root.icon-color; filled: root.icon == Icons.gameplay; }
        }
        Text {
            text: root.label;
            font-size: 10.5px;
            font-weight: root.selected ? 600 : 400;
            color: root.label-color;
            horizontal-alignment: center;
            overflow: elide;
            animate color { duration: 140ms; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

// The sections, chosen with the pointer or (once focused) the arrow keys.
component Nav inherits FocusScope {
    in property <[Section]> sections;
    in-out property <int> current;
    in property <bool> stacked;

    accessible-role: tab-list;
    accessible-label: "Settings sections";
    // Its items' height (a strip's, or a column's of rows of 38 and gaps of 2).
    min-height: root.stacked ? 58px : root.sections.length * 40px + 2px;
    key-pressed(event) => {
        if event.text == Key.UpArrow || event.text == Key.LeftArrow {
            root.current = max(0, root.current - 1);
            return accept;
        }
        if event.text == Key.DownArrow || event.text == Key.RightArrow {
            root.current = min(root.sections.length - 1, root.current + 1);
            return accept;
        }
        if event.text == Key.Home {
            root.current = 0;
            return accept;
        }
        if event.text == Key.End {
            root.current = root.sections.length - 1;
            return accept;
        }
        reject
    }
    Rectangle {
        border-radius: 10px;
        border-width: root.has-focus ? 1px : 0px;
        border-color: Theme.accent;
    }
    if !root.stacked: VerticalLayout {
        padding: 2px;
        spacing: 2px;
        alignment: start;
        for section[index] in root.sections: NavItem {
            label: section.label;
            icon: section.icon;
            selected: index == root.current;
            activated => { root.current = index; }
        }
    }
    if root.stacked: HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for section[index] in root.sections: NavItem {
            stacked: true;
            horizontal-stretch: 1;
            label: section.label;
            icon: section.icon;
            selected: index == root.current;
            activated => { root.current = index; }
        }
    }
}

// A group of settings, labelled for assistive navigation, and its heading
// (if it has one) above it.
component Card inherits VerticalLayout {
    in property <string> title;
    in property <string> heading;
    spacing: 7px;
    padding-top: root.heading != "" ? 6px : 0px;
    if root.heading != "": Text {
        text: root.heading;
        font-size: 12px;
        font-weight: 600;
        color: Theme.text-secondary;
    }
    Rectangle {
        background: Theme.raised;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.stroke;
        accessible-role: groupbox;
        accessible-label: root.title;
        VerticalLayout {
            padding: 14px;
            padding-top: 12px;
            spacing: 12px;
            @children
        }
    }
}

// A setting: its name on the left, its control on the right.
component Row inherits HorizontalLayout {
    in property <string> label;
    in property <bool> enabled: true;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text { text: root.label; font-size: 13px; color: root.enabled ? Theme.text : Theme.text-tertiary; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;
        @children
    }
}

// Dropdown selection is deliberate: clicks and arrow keys select, while wheel
// input continues to the containing scroll view (including the open menu).
component Choice inherits FocusScope {
    in property <[string]> model;
    in-out property <int> current-index;
    callback selected();
    private property <bool> expanded;
    function pick(index: int) {
        root.current-index = clamp(index, 0, root.model.length - 1);
        root.selected();
    }
    function open() { root.expanded = true; popup.show(); }
    function close() { root.expanded = false; popup.close(); root.focus(); }
    accessible-role: combobox;
    accessible-value: root.model[root.current-index];
    accessible-expandable: true;
    accessible-expanded: root.expanded;
    accessible-action-expand => { root.open(); }
    min-width: 130px;
    min-height: 32px;
    vertical-stretch: 0;
    key-pressed(event) => {
        if event.text == Key.UpArrow { root.pick(root.current-index - 1); return accept; }
        if event.text == Key.DownArrow { root.pick(root.current-index + 1); return accept; }
        if event.text == Key.Return || event.text == Key.Space { root.open(); return accept; }
        reject
    }
    Rectangle {
        background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : Theme.well;
        border-radius: 5px;
        border-width: 1px;
        border-color: root.has-focus ? Theme.accent : Theme.stroke;
        HorizontalLayout {
            padding-left: 11px; padding-right: 10px; spacing: 8px;
            Text { text: root.model[root.current-index]; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; accessible-role: none; }
            VerticalLayout {
                alignment: center; horizontal-stretch: 0;
                Icon { width: 12px; height: 12px; data: "M6 9 L12 15 L18 9"; color: Theme.text-secondary; }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.focus(); root.open(); }
    }
    popup := PopupWindow {
        x: 0; y: root.height + 4px; width: root.width;
        height: min(6, root.model.length) * 32px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;
        popup-focus := FocusScope {
            focus-changed-event => { root.expanded = self.has-focus; }
            key-pressed(event) => {
                if event.text == Key.UpArrow { root.pick(root.current-index - 1); return accept; }
                if event.text == Key.DownArrow { root.pick(root.current-index + 1); return accept; }
                if event.text == Key.Return || event.text == Key.Escape { root.close(); return accept; }
                reject
            }
            Rectangle {
                background: #202329; border-radius: 5px; border-width: 1px; border-color: Theme.stroke;
                ScrollView {
                    content-y: -max(0, root.current-index - 5) * 32px;
                    VerticalLayout {
                        padding: 4px; spacing: 0px;
                        for value[index] in root.model: Rectangle {
                            height: 32px; border-radius: 3px;
                            background: item-touch.pressed ? Theme.pressed : item-touch.has-hover ? Theme.hover : index == root.current-index ? Theme.selected : transparent;
                            accessible-role: list-item; accessible-label: value;
                            accessible-item-selected: index == root.current-index;
                            accessible-action-default => { root.pick(index); root.close(); }
                            Text { x: 8px; width: parent.width - 16px; text: value; color: Theme.text; font-size: 13px; vertical-alignment: center; accessible-role: none; }
                            item-touch := TouchArea { clicked => { root.pick(index); root.close(); } }
                        }
                    }
                }
            }
        }
    }
}

// A setting that is on or off: the switch, or anywhere on its row, toggles
// it; the row lights up under the pointer.
component ToggleRow inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    callback toggled(bool);
    function toggle() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
    min-height: layout.min-height;
    Rectangle {
        x: -8px;
        width: parent.width + 16px;
        y: -5px;
        height: parent.height + 10px;
        border-radius: 8px;
        background: row-touch.pressed ? Theme.pressed : row-touch.has-hover ? Theme.hover : transparent;
        animate background { duration: 140ms; easing: ease-out; }
    }
    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
    layout := HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.label; font-size: 13px; color: Theme.text; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Switch { accessible-label: root.label; checked <=> root.checked; toggled => { root.toggled(self.checked); } }
        }
    }
}

// A setting with a slider under its name, its value at the right.
component SliderRow inherits VerticalLayout {
    in property <string> label;
    in property <string> value-text;
    spacing: 4px;
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.label; font-size: 13px; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
        Text { text: root.value-text; font-size: 12.5px; font-weight: 600; color: Theme.accent; horizontal-stretch: 0; vertical-alignment: center; }
    }
    @children
}

// A short choice of a few options side by side; the arrow keys move it once
// it has the focus. On a panel too narrow for it an option of several words
// wraps them.
component Segmented inherits FocusScope {
    in property <[string]> options;
    in-out property <int> current;
    callback selected(int);

    function pick(index: int) {
        if root.enabled && index >= 0 && index < root.options.length && index != root.current {
            root.current = index;
            root.selected(index);
        }
    }

    accessible-role: radio-group;
    accessible-enabled: root.enabled;
    horizontal-stretch: 0;
    min-height: 32px;
    key-pressed(event) => {
        if event.text == Key.LeftArrow {
            root.pick(root.current - 1);
            return accept;
        }
        if event.text == Key.RightArrow {
            root.pick(root.current + 1);
            return accept;
        }
        reject
    }
    Rectangle {
        border-radius: 8px;
        background: Theme.well;
        border-width: 1px;
        border-color: root.has-focus ? Theme.accent : Theme.stroke;
        HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            for option[index] in root.options: Rectangle {
                accessible-role: radio-button;
                accessible-label: option;
                accessible-checkable: true;
                accessible-checked: index == root.current;
                accessible-enabled: root.enabled;
                accessible-action-default => { root.pick(index); }
                min-width: max(52px, label.min-width + 20px);
                preferred-width: max(52px, label.preferred-width + 20px);
                min-height: label.preferred-height + 10px;
                border-radius: 6px;
                background: index == root.current ? (touch.has-hover && root.enabled ? #ffffff2e : #ffffff26)
                    : touch.pressed && root.enabled ? Theme.pressed : touch.has-hover && root.enabled ? Theme.hover : transparent;
                // The chosen one lifted off the track; the others flat on it.
                drop-shadow-blur: 4px;
                drop-shadow-color: index == root.current ? #00000059 : transparent;
                drop-shadow-offset-y: 1px;
                animate background { duration: 140ms; easing: ease-out; }
                label := Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: option;
                    font-size: 12.5px;
                    font-weight: index == root.current ? 600 : 400;
                    color: !root.enabled ? Theme.text-tertiary : index == root.current || touch.has-hover ? Theme.text : Theme.text-secondary;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: 140ms; }
                }
                touch := TouchArea {
                    mouse-cursor: root.enabled && index != root.current ? MouseCursor.pointer : MouseCursor.default;
                    clicked => { root.pick(index); }
                }
            }
        }
    }
}

// A header button: an icon, and its text beside it when it has one (an
// icon alone is named by its label). Tab reaches it; Space or Return presses it.
component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> text;
    // The icon's colour under the pointer (Quit's warns).
    in property <brush> hover-icon-color: Theme.text;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : root.label;
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;
    width: root.text == "" ? 34px : content.preferred-width;
    height: 34px;
    border-radius: 8px;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.stroke : transparent;
    animate background, border-color { duration: 140ms; easing: ease-out; }
    content := HorizontalLayout {
        padding-left: root.text == "" ? 8px : 10px;
        padding-right: root.text == "" ? 8px : 13px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon { data: root.icon; color: touch.has-hover ? root.hover-icon-color : Theme.text-secondary; }
        }
        if root.text != "": Text {
            text: root.text;
            font-size: 12.5px;
            color: touch.has-hover ? Theme.text : Theme.text-secondary;
            vertical-alignment: center;
            animate color { duration: 140ms; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    // As the toolkit's Button: no area of its own, so a click does not focus it.
    focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    if focus.has-focus: Rectangle {
        border-radius: root.border-radius;
        border-width: 1.5px;
        border-color: Theme.accent;
    }
}

// Asks before the app quits, over the dimmed panel. A press beside it, or
// the host's Escape or Back, cancels; Tab moves between its two buttons only.
component QuitDialog inherits Rectangle {
    callback cancelled();
    callback confirmed();
    private property <float> shown;
    init => { root.shown = 1; }
    opacity: root.shown;
    animate opacity { duration: 120ms; easing: ease-out; }
    background: #0a0b0eb8;
    TouchArea {
        clicked => { root.cancelled(); }
        scroll-event(event) => { accept }
    }
    // The dialog takes the keys at once (no ring shows); Tab reaches its buttons.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        init => { self.focus(); }
        width: min(340px, root.width - 32px);
        height: card.min-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        capture-key-pressed(event) => {
            if event.text == Key.Tab || event.text == Key.Backtab {
                if cancel.has-focus {
                    quit.focus();
                } else {
                    cancel.focus();
                }
                return accept;
            }
            reject
        }
        card := Rectangle {
            accessible-role: groupbox;
            accessible-label: "Quit Xenogears Ex Machina?";
            min-height: layout.min-height;
            background: #1c1f26;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.stroke;
            drop-shadow-blur: 28px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: #00000099;
            // A press on the dialog is not one beside it.
            TouchArea { }
            layout := VerticalLayout {
                padding: 20px;
                padding-bottom: 16px;
                spacing: 18px;
                HorizontalLayout {
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 18px;
                            background: Theme.bad.with-alpha(0.13);
                            Icon {
                                data: Icons.power;
                                color: Theme.bad;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "Quit Xenogears Ex Machina?"; font-size: 15px; font-weight: 650; color: Theme.text; wrap: word-wrap; }
                        Text { text: "Progress since your last save is lost."; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    cancel := Button {
                        text: "Cancel";
                        clicked => { root.cancelled(); }
                    }
                    quit := Button {
                        text: "Quit";
                        primary: true;
                        clicked => { root.confirmed(); }
                    }
                }
            }
        }
    }
}

// A key or button, as a keycap; "-" for none.
component Keycap inherits Rectangle {
    in property <string> text;
    min-width: label.preferred-width + 12px;
    height: 20px;
    border-radius: 4px;
    background: root.text == "" ? transparent : #ffffff12;
    border-width: root.text == "" ? 0px : 1px;
    border-color: #ffffff1f;
    accessible-role: none;
    label := Text {
        text: root.text == "" ? "—" : root.text;
        font-size: 11px;
        color: root.text == "" ? Theme.text-tertiary : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A game control and what plays it: keycaps on the right.
component ControlRow inherits HorizontalLayout {
    in property <string> action;
    in property <[string]> inputs;
    spacing: 12px;
    Text { text: root.action; font-size: 12.5px; color: Theme.text-secondary; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; }
    HorizontalLayout {
        horizontal-stretch: 0;
        spacing: 4px;
        alignment: end;
        for input in root.inputs: Keycap { text: input; }
    }
}

export component SettingsPanel inherits Window {
    in-out property <float> master-volume;
    // 0 Mono, 1 Stereo, 2 Wide (the game's own modes), 3 Binaural.
    in-out property <int> audio-output;
    // The Binaural mode's options (xem_settings::Binaural).
    in-out property <bool> binaural-music: true;
    in-out property <bool> binaural-effects: true;
    in-out property <float> binaural-immersion: 70;
    in-out property <bool> binaural-head;
    in-out property <int> scale;
    in-out property <int> filter;
    in-out property <bool> show-fps;
    // Graphics (xem_settings::Graphics): indexes into the models below.
    // 0 Original (the console's picture), 1 Ex Machina's renderer.
    in-out property <int> gfx-renderer: 1;
    in-out property <int> gfx-profile;
    in-out property <int> gfx-scale;
    in-out property <int> gfx-quality;
    in-out property <bool> gfx-interpolation;
    in-out property <bool> gfx-widescreen;
    // The field camera pulled back, percent (100-500).
    in-out property <int> gfx-zoom-out: 100;
    in-out property <int> gfx-filter-world;
    in-out property <int> gfx-filter-sprites;
    in-out property <int> gfx-filter-interface;
    in-out property <int> gfx-filter-movies;
    // Custom profile limits, in the order of fidelity-names.
    in-out property <[bool]> gfx-fidelity;
    // Effect levels of the selected profile (HD-2D or Custom), in the order of effect-names.
    in-out property <[int]> gfx-effects;
    in-out property <int> gfx-xr-distance;
    in-out property <int> gfx-xr-width;
    in-out property <bool> gfx-xr-dof;
    // What a headset shows (0 the screen, 1 the diorama) and the diorama's
    // scale (percent), table height and distance (cm), tilt (degrees), turns
    // (0 smooth, 1 snap, 2 fixed) and passthrough; a note on what the
    // diorama does not draw.
    in-out property <int> gfx-xr-view;
    in-out property <int> gfx-xr-scale: 100;
    in-out property <int> gfx-xr-height: -45;
    in-out property <int> gfx-xr-table-distance: 60;
    in-out property <int> gfx-xr-tilt;
    in-out property <int> gfx-xr-turns;
    in-out property <bool> gfx-xr-passthrough;
    in property <string> gfx-xr-note;
    // The host shows the panel in a headset (Recenter places its view), and
    // its headset offers passthrough.
    in property <bool> in-headset;
    in property <bool> xr-passthrough-offered;
    // The host keeps saves in a browser's storage, which it can ask the
    // browser to persist (Request browser persistence; the Rust side lists
    // the operations offered).
    in property <bool> browser-storage;
    in property <string> gfx-status;
    private property <[string]> fidelity-names: ["Affine textures", "Vertex snapping", "15-bit colour", "Dithering", "Native resolution", "Painter's ordering"];
    private property <[string]> effect-names: ["Lighting", "Shadows", "Ambient occlusion", "Fog", "Light shafts", "Bloom", "Colour grading", "Depth of field", "Focus"];
    in-out property <bool> pause-on-focus-loss;
    // What failed (an operation, a change, the game), in the error bar
    // until the next success or Dismiss; none, no bar.
    in-out property <string> error;
    // The app's version, in About.
    in property <string> version;
    // The host offers first-person inspection (the game controls list it),
    // its touch controls show (a finger dragged on the picture looks), and
    // it plays in a headset (the underhand grab and the controllers' Back,
    // their right stick's click, toggle it; their right stick turns it).
    in property <bool> first-person;
    in property <bool> first-person-touch;
    in property <bool> first-person-headset;
    in property <bool> can-import-disc;
    // The host can quit (desktop, Android, a headset): Quit in the header,
    // which asks first.
    in property <bool> can-quit;
    in property <bool> can-reset;
    in-out property <bool> quit-confirming;
    // The host places its own window (desktop): Graphics offers Fullscreen.
    in property <bool> can-fullscreen;
    in-out property <bool> fullscreen;
    in property <string> disc-status: "No disc imported";
    // Every app operation with its bindings; the selected one is edited.
    in property <[BindingRow]> bindings;
    in-out property <int> selected-action: -1;
    in-out property <string> keyboard-binding;
    in-out property <string> gamepad-binding;
    in property <[string]> backup-actions;
    // The Backups card's buttons two to a row on a panel wide enough for
    // its longest pair (a desktop's 640), else one to a row.
    private property <int> backup-columns: root.width >= 600px ? 2 : 1;
    // Every game action with its inputs (xem_settings::bindings); the
    // selected one (-1 none) is edited: keys, gamepad inputs, mouse buttons.
    in property <[BindingRow]> game-bindings;
    in-out property <int> selected-game-action: -1;
    in-out property <string> game-keys;
    in-out property <string> game-buttons;
    in-out property <string> game-mouse;
    in-out property <int> selected-section: 0;
    in property <bool> wide-layout;
    private property <[Section]> sections: [
        { label: "Audio", icon: Icons.audio },
        { label: "Graphics", icon: Icons.graphics },
        { label: "Controls", icon: Icons.controls },
        { label: "Shortcuts", icon: Icons.shortcuts },
        { label: "Time", icon: Icons.time },
        { label: "Saves", icon: Icons.saves },
        { label: "Gameplay", icon: Icons.gameplay },
        { label: "Debug", icon: Icons.bug },
        { label: "About", icon: Icons.about },
    ];
    out property <int> section-count: root.sections.length;
    in property <bool> debug-available;
    in property <bool> debug-busy;
    in property <string> debug-status: "Boot a game to use Debug.";
    in-out property <int> debug-map;
    in-out property <int> debug-entry;
    in-out property <int> debug-formation: 3;
    in-out property <int> debug-battle-file;
    in-out property <[int]> debug-party: [0, 1, 2];
    in-out property <[int]> debug-gears: [0, 0, 0];
    in-out property <int> debug-worldmap: 1024;
    in-out property <int> debug-menu;
    in-out property <int> debug-parameter;
    in-out property <int> debug-movie;
    in-out property <int> debug-movie-kind: 1;
    callback debug-requested(int);
    in property <string> time-status: "Boot a game to use rewind.";
    in property <string> storage-status;
    in property <bool> fast-forward;
    in property <int> fast-forward-rate;
    in property <[string]> fast-forward-rates;
    in-out property <float> fast-forward-position;
    in-out property <bool> invert-trigger-chords;
    in-out property <bool> mouse-camera;
    in-out property <int> mouse-sensitivity: 50;
    in-out property <int> mouse-deadzone: 40;
    in-out property <bool> run-by-default;
    // Where the field's random battles happen (xem_settings::RandomBattles:
    // 0 not while platforming, 1 the original's).
    in-out property <int> random-battles;
    // How often the ones left on come (xem_settings::EncounterRate: 0
    // Original, 1 Half).
    in-out property <int> encounter-rate;
    // The message windows' text speed (xem_settings::TextSpeed: 0 Original,
    // 1 Fast, 2 Instant), auto-advance dialogue and its wait on each page
    // (vertical blanks), and whether movies can be skipped.
    in-out property <int> text-speed;
    in-out property <bool> auto-advance;
    in-out property <int> auto-advance-dwell: 120;
    in-out property <bool> movie-skip;
    // The assisted controls (xem_settings::Assisted): hand gestures, the
    // headset pointer (0 eye gaze, 1 head, 2 left hand, 3 right hand), the
    // ledge brake, touch controls, reduced transparency and motion.
    in-out property <bool> assist-gestures;
    in-out property <int> assist-pointer;
    in-out property <bool> assist-ledge-brake;
    in-out property <bool> assist-touch;
    in-out property <bool> assist-solid;
    in-out property <bool> assist-still;
    in-out property <bool> rewind-enabled;
    in-out property <int> rewind-interval-seconds;
    in property <int> rewind-interval-max;
    in-out property <int> rewind-history-seconds;
    in property <int> rewind-history-max;
    private property <bool> keyboard-editor-focused;
    private property <bool> gamepad-editor-focused;
    private property <bool> rewind-interval-focused;
    private property <bool> rewind-history-focused;
    private property <bool> game-editor-focused;
    out property <bool> text-editor-focused: keyboard-editor-focused || gamepad-editor-focused || rewind-interval-focused || rewind-history-focused || game-editor-focused;
    callback action-selected(int);
    callback binding-edited(int, string, string);
    callback game-action-selected(int);
    callback game-binding-edited(int, string, string, string);
    callback game-bindings-reset();
    callback app-action-requested(int);
    callback backup-action-requested(int);
    callback fast-forward-rate-edited(int);
    callback invert-trigger-chords-edited(bool);
    callback mouse-camera-edited(bool);
    callback mouse-sensitivity-edited(int);
    callback mouse-deadzone-edited(int);
    callback run-by-default-edited(bool);
    callback random-battles-edited(int);
    // A gameplay option by name (encounter-rate, text-speed, auto-advance,
    // auto-advance-dwell, movie-skip) and value.
    callback gameplay-edited(string, int);
    // An assisted-controls choice by name (gestures, pointer, ledge-brake,
    // touch, solid, still) and value.
    callback assist-edited(string, int);
    callback rewind-enabled-edited(bool);
    callback rewind-interval-edited(int);
    callback rewind-history-edited(int);
    callback rewind-held(bool);
    callback master-volume-edited(int);
    callback audio-output-edited(int);
    // A Binaural option by name (music, effects, immersion, head) and value.
    callback binaural-edited(string, int);
    callback scale-edited(int);
    callback filter-edited(int);
    callback show-fps-edited(bool);
    // A graphics choice by name (renderer, profile, scale, quality, interpolation,
    // widescreen, zoom-out, filter-world, filter-sprites, filter-interface,
    // xr-distance, xr-width, xr-dof, xr-view, xr-scale, xr-height,
    // xr-table-distance, xr-tilt, xr-turns, xr-passthrough, xr-diorama-reset)
    // and value.
    callback graphics-edited(string, int);
    // Recenter: the headset's view placed in front of the head again.
    callback xr-recenter-requested();
    callback fidelity-edited(int, bool);
    callback effect-edited(int, int);
    callback pause-on-focus-loss-edited(bool);
    callback close-requested();
    callback import-disc-requested();
    callback quit-requested();
    callback reset-requested();
    callback fullscreen-edited(bool);

    changed selected-section => {
        section-scroll.content-y = 0px;
        root.keyboard-editor-focused = false;
        root.gamepad-editor-focused = false;
        root.rewind-interval-focused = false;
        root.rewind-history-focused = false;
        root.game-editor-focused = false;
        root.rewind-held(false);
    }

    function select-game-action(index: int) {
        if index >= -1 && index < root.game-bindings.length && index != root.selected-game-action {
            root.selected-game-action = index;
            root.game-editor-focused = false;
            root.game-action-selected(index);
        }
    }

    function select-action(index: int) {
        if index >= -1 && index < root.bindings.length && index != root.selected-action {
            root.selected-action = index;
            root.keyboard-editor-focused = false;
            root.gamepad-editor-focused = false;
            root.action-selected(index);
        }
    }

    title: "Settings";
    background: transparent;
    preferred-width: 640px;
    preferred-height: 560px;
    min-width: 280px;
    min-height: 280px;

    Rectangle {
        background: Theme.panel;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.stroke;
        clip: true;
        VerticalLayout {
            // The header.
            HorizontalLayout {
                padding: 13px;
                padding-left: 16px;
                spacing: 12px;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 9px;
                    background: Palette.accent-background.with-alpha(0.14);
                    border-width: 1px;
                    border-color: Palette.accent-background.with-alpha(0.3);
                    Icon {
                        data: Icons.emblem;
                        color: Theme.accent;
                        width: 20px;
                        height: 20px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    horizontal-stretch: 1;
                    Text { text: "Settings"; font-size: 17px; font-weight: 650; color: Theme.text; }
                }
                if root.can-reset: VerticalLayout {
                    alignment: center;
                    IconButton { icon: Icons.reset; label: "Reset"; text: root.wide-layout ? "Reset" : ""; clicked => { root.reset-requested(); } }
                }
                if root.can-quit: VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.power;
                        label: "Quit";
                        text: root.wide-layout ? "Quit" : "";
                        hover-icon-color: Theme.bad;
                        clicked => { root.quit-confirming = true; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton { icon: Icons.close; label: "Close"; clicked => { root.close-requested(); } }
                }
            }
            Divider { }
            HorizontalLayout {
                vertical-stretch: 1;
                if root.wide-layout: Rectangle {
                    width: 164px;
                    VerticalLayout {
                        padding: 10px;
                        padding-top: 12px;
                        Nav {
                            sections: root.sections;
                            current <=> root.selected-section;
                            vertical-stretch: 0;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                if root.wide-layout: Rectangle { width: 1px; background: Theme.divider; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    if !root.wide-layout: VerticalLayout {
                        padding: 8px;
                        padding-bottom: 6px;
                        vertical-stretch: 0;
                        Nav {
                            stacked: true;
                            sections: root.sections;
                            current <=> root.selected-section;
                        }
                    }
                    if !root.wide-layout: Divider { }
                    section-scroll := ScrollView {
                        accessible-role: tab-panel;
                        accessible-label: root.sections[root.selected-section].label;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        // Narrow touch hosts pan the form; desktop mouse
                        // presses reach sliders at once, without a pan delay.
                        mouse-drag-pan-enabled: !root.wide-layout;
                        content-width: self.visible-width;
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 20px;
                            padding-top: 8px;
                            padding-bottom: 16px;
                            spacing: 12px;
                            alignment: start;

                            // Audio
                            if root.selected-section == 0: Card {
                                title: "Sound";

                                SliderRow {
                                    label: "Master volume";
                                    value-text: "\{round(root.master-volume)}%";
                                    Slider { accessible-label: "Master volume"; minimum: 0; maximum: 100; value <=> root.master-volume; changed(value) => { root.master-volume-edited(round(value)); } }
                                }
                                Divider { }
                                Row {
                                    label: "Sound mode";
                                    Segmented { accessible-label: "Sound mode"; options: ["Mono", "Stereo", "Wide", "Binaural"]; current <=> root.audio-output; selected(index) => { root.audio-output-edited(index); } }
                                }
                                if root.audio-output == 3: Divider { }
                                if root.audio-output == 3: ToggleRow {
                                    label: "Spatial music";
                                    checked <=> root.binaural-music;
                                    toggled(on) => { root.binaural-edited("music", on ? 1 : 0); }
                                }
                                if root.audio-output == 3: ToggleRow {
                                    label: "Positional effects";
                                    checked <=> root.binaural-effects;
                                    toggled(on) => { root.binaural-edited("effects", on ? 1 : 0); }
                                }
                                if root.audio-output == 3: SliderRow {
                                    label: "Music immersion";
                                    value-text: "\{round(root.binaural-immersion)}%";
                                    Slider { accessible-label: "Music immersion"; minimum: 0; maximum: 100; value <=> root.binaural-immersion; changed(value) => { root.binaural-edited("immersion", round(value)); } }
                                }
                                if root.audio-output == 3: ToggleRow {
                                    label: "VR: Stationary music";
                                    checked <=> root.binaural-head;
                                    toggled(on) => { root.binaural-edited("head", on ? 1 : 0); }
                                }
                            }

                            // Graphics
                            if root.selected-section == 1: Card {
                                title: "Picture";

                                if root.can-fullscreen: ToggleRow {
                                    label: "Fullscreen";
                                    checked <=> root.fullscreen;
                                    toggled(on) => { root.fullscreen-edited(on); }
                                }
                                if root.can-fullscreen: Divider { }
                                Row {
                                    label: "Renderer";
                                    Segmented { accessible-label: "Renderer"; options: ["Original", "Ex Machina"]; current <=> root.gfx-renderer; selected(index) => { root.graphics-edited("renderer", index); } }
                                }
                                Divider { }
                                Row {
                                    label: "Scale";
                                    Choice { accessible-label: "Scale"; width: 150px; model: ["Fit", "Integer", "Stretch"]; current-index <=> root.scale; selected => { root.scale-edited(self.current-index); } }
                                }
                                Divider { }
                                Row {
                                    label: "Filter";
                                    Segmented { accessible-label: "Filter"; options: ["Nearest", "Linear"]; current <=> root.filter; selected(index) => { root.filter-edited(index); } }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Show FPS";
                                    checked <=> root.show-fps;
                                    toggled(on) => { root.show-fps-edited(on); }
                                }
                            }
                            if root.selected-section == 1 && root.gfx-renderer == 1: Card {
                                title: "Look";

                                Row {
                                    label: "Profile";
                                    Choice { accessible-label: "Graphics profile"; width: 150px; model: ["Modern", "HD-2D", "PS1", "Custom"]; current-index <=> root.gfx-profile; selected => { root.graphics-edited("profile", self.current-index); } }
                                }
                                if root.gfx-profile != 2: Divider { }
                                if root.gfx-profile != 2: Row {
                                    label: "Resolution";
                                    Choice { accessible-label: "Internal resolution"; width: 150px; model: ["Auto", "1x", "2x", "3x", "4x", "5x", "6x", "7x", "8x"]; current-index <=> root.gfx-scale; selected => { root.graphics-edited("scale", self.current-index); } }
                                }
                                if root.gfx-profile == 1 || root.gfx-profile == 3: Divider { }
                                if root.gfx-profile == 1 || root.gfx-profile == 3: Row {
                                    label: "HD-2D quality";
                                    Choice { accessible-label: "HD-2D quality"; width: 150px; model: ["Auto", "Low", "Medium", "High", "Ultra"]; current-index <=> root.gfx-quality; selected => { root.graphics-edited("quality", self.current-index); } }
                                }
                                if root.gfx-status != "": Text { text: root.gfx-status; font-size: 11.5px; color: Theme.text-secondary; wrap: word-wrap; }
                            }
                            if root.selected-section == 1 && root.gfx-renderer == 1: Card {
                                title: "Motion and framing";
                                ToggleRow {
                                    label: "Interpolate motion";
                                    checked <=> root.gfx-interpolation;
                                    toggled(on) => { root.graphics-edited("interpolation", on ? 1 : 0); }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Wider framing";
                                    checked <=> root.gfx-widescreen;
                                    toggled(on) => { root.graphics-edited("widescreen", on ? 1 : 0); }
                                }
                                Divider { }
                                SliderRow {
                                    label: "Zoom out";
                                    value-text: "\{root.gfx-zoom-out / 100}x";
                                    Slider {
                                        accessible-label: "Field camera zoom out (mouse wheel)";
                                        minimum: 100;
                                        maximum: 500;
                                        value: root.gfx-zoom-out;
                                        changed(value) => { root.graphics-edited("zoom-out", round(value / 25) * 25); }
                                    }
                                }
                            }
                            if root.selected-section == 1 && root.gfx-renderer == 1 && (root.gfx-profile == 1 || root.gfx-profile == 3): Card {
                                title: root.gfx-profile == 1 ? "HD-2D effects" : "Effects";

                                for name[index] in root.effect-names: HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: name; font-size: 12.5px; color: Theme.text-secondary; vertical-alignment: center; min-width: 118px; horizontal-stretch: 0; }
                                    Slider {
                                        accessible-label: name;
                                        minimum: index == 8 ? -100 : 0;
                                        maximum: 100;
                                        value: root.gfx-effects[index];
                                        released(value) => { root.effect-edited(index, round(value)); }
                                    }
                                    Text { text: root.gfx-effects[index]; font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-alignment: right; min-width: 30px; horizontal-stretch: 0; }
                                }
                            }
                            if root.selected-section == 1 && root.gfx-renderer == 1 && root.gfx-profile == 3: Card {
                                title: "Original limits";

                                for name[index] in root.fidelity-names: ToggleRow {
                                    label: name;
                                    checked: root.gfx-fidelity[index];
                                    toggled(on) => { root.fidelity-edited(index, on); }
                                }
                            }
                            if root.selected-section == 1 && root.gfx-renderer == 1: Card {
                                title: "Filtering";
                                heading: "Texture Filtering";
                                Row {
                                    label: "World";
                                    Segmented { accessible-label: "World filtering"; options: ["Nearest", "Linear"]; current <=> root.gfx-filter-world; selected(index) => { root.graphics-edited("filter-world", index); } }
                                }
                                Row {
                                    label: "Sprites";
                                    Segmented { accessible-label: "Sprite filtering"; options: ["Nearest", "Linear"]; current <=> root.gfx-filter-sprites; selected(index) => { root.graphics-edited("filter-sprites", index); } }
                                }
                                Row {
                                    label: "Interface";
                                    Segmented { accessible-label: "Interface filtering"; options: ["Nearest", "Linear"]; current <=> root.gfx-filter-interface; selected(index) => { root.graphics-edited("filter-interface", index); } }
                                }
                                Row {
                                    label: "Movies";
                                    Segmented { accessible-label: "Movies"; options: ["Enhanced", "Original"]; current <=> root.gfx-filter-movies; selected(index) => { root.graphics-edited("filter-movies", index); } }
                                }
                            }
                            if root.selected-section == 1: Card {
                                title: "Headset";
                                heading: "VR";

                                Row {
                                    label: "View";
                                    Segmented { accessible-label: "Headset view"; options: ["Screen", "Diorama"]; current <=> root.gfx-xr-view; selected(index) => { root.graphics-edited("xr-view", index); } }
                                }
                                Divider { }
                                // The screen (also where the diorama gives way to it).
                                Row {
                                    label: root.gfx-xr-view == 1 ? "Screen distance" : "Distance";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SpinBox { accessible-label: "Headset screen distance in centimetres"; width: 104px; minimum: 50; maximum: 2000; step-size: 10; value <=> root.gfx-xr-distance; edited(value) => { root.graphics-edited("xr-distance", value); } }
                                        Text { text: "cm"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 24px; }
                                    }
                                }
                                Divider { }
                                Row {
                                    label: root.gfx-xr-view == 1 ? "Screen width" : "Width";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SpinBox { accessible-label: "Headset screen width in centimetres"; width: 104px; minimum: 50; maximum: 2000; step-size: 10; value <=> root.gfx-xr-width; edited(value) => { root.graphics-edited("xr-width", value); } }
                                        Text { text: "cm"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 24px; }
                                    }
                                }
                                if root.gfx-xr-view == 1: Divider { }
                                if root.gfx-xr-view == 1: SliderRow {
                                    label: "Diorama scale";
                                    value-text: "\{root.gfx-xr-scale}%";
                                    Slider {
                                        accessible-label: "Diorama scale";
                                        minimum: 25;
                                        maximum: 400;
                                        value: root.gfx-xr-scale;
                                        changed(value) => { root.graphics-edited("xr-scale", round(value / 5) * 5); }
                                    }
                                }
                                if root.gfx-xr-view == 1: Row {
                                    label: "Table height";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SpinBox { accessible-label: "Diorama table height from the head in centimetres"; width: 104px; minimum: -100; maximum: 30; step-size: 5; value <=> root.gfx-xr-height; edited(value) => { root.graphics-edited("xr-height", value); } }
                                        Text { text: "cm"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 24px; }
                                    }
                                }
                                if root.gfx-xr-view == 1: Row {
                                    label: "Table distance";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SpinBox { accessible-label: "Diorama table distance in centimetres"; width: 104px; minimum: 30; maximum: 200; step-size: 5; value <=> root.gfx-xr-table-distance; edited(value) => { root.graphics-edited("xr-table-distance", value); } }
                                        Text { text: "cm"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 24px; }
                                    }
                                }
                                if root.gfx-xr-view == 1: SliderRow {
                                    label: "Table tilt";
                                    value-text: "\{root.gfx-xr-tilt}°";
                                    Slider {
                                        accessible-label: "Diorama table tilt";
                                        minimum: 0;
                                        maximum: 45;
                                        value: root.gfx-xr-tilt;
                                        changed(value) => { root.graphics-edited("xr-tilt", round(value)); }
                                    }
                                }
                                if root.gfx-xr-view == 1: Row {
                                    label: "Table turns";
                                    Segmented { accessible-label: "Diorama table turns"; options: ["Smooth", "Snap", "Fixed"]; current <=> root.gfx-xr-turns; selected(index) => { root.graphics-edited("xr-turns", index); } }
                                }
                                if root.gfx-xr-view == 1 && root.xr-passthrough-offered: ToggleRow {
                                    label: "Passthrough";
                                    checked <=> root.gfx-xr-passthrough;
                                    toggled(on) => { root.graphics-edited("xr-passthrough", on ? 1 : 0); }
                                }
                                if root.gfx-xr-view == 1 && root.gfx-xr-note != "": Text { text: root.gfx-xr-note; font-size: 11.5px; color: Theme.text-secondary; wrap: word-wrap; }
                                if root.in-headset || root.gfx-xr-view == 1: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    if root.in-headset: Button { text: "Recenter"; clicked => { root.xr-recenter-requested(); } }
                                    if root.gfx-xr-view == 1: Button { text: "Reset diorama"; clicked => { root.graphics-edited("xr-diorama-reset", 0); } }
                                }
                                if root.gfx-renderer == 1: Divider { }
                                if root.gfx-renderer == 1: ToggleRow {
                                    label: "Depth of field";
                                    checked <=> root.gfx-xr-dof;
                                    toggled(on) => { root.graphics-edited("xr-dof", on ? 1 : 0); }
                                }
                            }

                            // Controls
                            if root.selected-section == 2: Card {
                                title: "Movement, mouse and triggers";
                                ToggleRow {
                                    label: "Run by default";
                                    checked <=> root.run-by-default;
                                    toggled(on) => { root.run-by-default-edited(on); }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Turn the camera with the mouse";
                                    checked <=> root.mouse-camera;
                                    toggled(on) => { root.mouse-camera-edited(on); }
                                }
                                if root.mouse-camera: SliderRow {
                                    label: "Mouse sensitivity";
                                    value-text: "\{root.mouse-sensitivity}%";
                                    Slider {
                                        accessible-label: "Mouse sensitivity";
                                        minimum: 10; maximum: 200;
                                        value: root.mouse-sensitivity;
                                        changed(value) => { root.mouse-sensitivity-edited(round(value / 5) * 5); }
                                    }
                                }
                                if root.mouse-camera: SliderRow {
                                    label: "Mouse deadzone";
                                    value-text: "\{root.mouse-deadzone} px";
                                    Slider {
                                        accessible-label: "Mouse deadzone";
                                        minimum: 0; maximum: 100;
                                        value: root.mouse-deadzone;
                                        changed(value) => { root.mouse-deadzone-edited(round(value)); }
                                    }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Invert LT/RT chords";
                                    checked <=> root.invert-trigger-chords;
                                    toggled(on) => { root.invert-trigger-chords-edited(on); }
                                }
                            }
                            if root.selected-section == 2: Card {
                                title: "Game controls";

                                game-actions := FocusScope {
                                    accessible-role: list;
                                    accessible-label: "Game controls";
                                    key-pressed(event) => {
                                        if event.text == Key.UpArrow {
                                            root.select-game-action(max(0, root.selected-game-action - 1));
                                            return accept;
                                        }
                                        if event.text == Key.DownArrow {
                                            root.select-game-action(root.selected-game-action + 1);
                                            return accept;
                                        }
                                        reject
                                    }
                                    VerticalLayout {
                                        spacing: 1px;
                                        for binding[index] in root.game-bindings: Rectangle {
                                            accessible-role: list-item;
                                            accessible-label: binding.name;
                                            accessible-item-selectable: true;
                                            accessible-item-selected: index == root.selected-game-action;
                                            accessible-item-index: index;
                                            accessible-action-default => { root.select-game-action(index); }
                                            border-radius: 7px;
                                            background: index == root.selected-game-action ? Theme.selected : game-touch.pressed ? Theme.pressed : game-touch.has-hover ? Theme.hover : transparent;
                                            border-width: index == root.selected-game-action ? 1px : 0px;
                                            border-color: Theme.stroke;
                                            animate background { duration: 140ms; easing: ease-out; }
                                            game-touch := TouchArea {
                                                mouse-cursor: index == root.selected-game-action ? MouseCursor.default : MouseCursor.pointer;
                                                clicked => { root.select-game-action(index); }
                                            }
                                            VerticalLayout {
                                                HorizontalLayout {
                                                    min-height: 30px;
                                                    padding-left: 10px;
                                                    padding-right: 8px;
                                                    spacing: 6px;
                                                    Text {
                                                        text: binding.name;
                                                        font-size: 12.5px;
                                                        font-weight: index == root.selected-game-action ? 600 : 400;
                                                        color: index == root.selected-game-action || game-touch.has-hover ? Theme.text : Theme.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }
                                                    VerticalLayout { alignment: center; Keycap { text: binding.keyboard; } }
                                                    VerticalLayout { alignment: center; Keycap { text: binding.gamepad; } }
                                                }
                                                if index == root.selected-game-action: VerticalLayout {
                                                    padding: 10px;
                                                    padding-top: 2px;
                                                    spacing: 8px;
                                                    Divider { }
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Text { text: "Keys"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 54px; horizontal-stretch: 0; }
                                                        LineEdit {
                                                            accessible-label: "Game keys";
                                                            text <=> root.game-keys;
                                                            changed has-focus => { root.game-editor-focused = self.has-focus; }
                                                            accepted => { root.game-binding-edited(root.selected-game-action, root.game-keys, root.game-buttons, root.game-mouse); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Text { text: "Gamepad"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 54px; horizontal-stretch: 0; }
                                                        LineEdit {
                                                            accessible-label: "Game gamepad inputs";
                                                            text <=> root.game-buttons;
                                                            changed has-focus => { root.game-editor-focused = self.has-focus; }
                                                            accepted => { root.game-binding-edited(root.selected-game-action, root.game-keys, root.game-buttons, root.game-mouse); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Text { text: "Mouse"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 54px; horizontal-stretch: 0; }
                                                        LineEdit {
                                                            accessible-label: "Game mouse buttons";
                                                            text <=> root.game-mouse;
                                                            changed has-focus => { root.game-editor-focused = self.has-focus; }
                                                            accepted => { root.game-binding-edited(root.selected-game-action, root.game-keys, root.game-buttons, root.game-mouse); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        alignment: end;
                                                        Button { text: "Cancel"; clicked => { root.select-game-action(-1); } }
                                                        Button { text: "Clear"; clicked => { root.game-binding-edited(root.selected-game-action, "", "", ""); } }
                                                        Button { text: "Save"; primary: true; clicked => { root.game-binding-edited(root.selected-game-action, root.game-keys, root.game-buttons, root.game-mouse); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    alignment: end;
                                    Button { text: "Restore defaults"; clicked => { root.game-bindings-reset(); } }
                                }
                            }
                            if root.selected-section == 2: Card {
                                title: "Headsets and touch screens";
                                heading: "VR / Touchscreen";

                                ToggleRow {
                                    label: "Hand gestures";
                                    checked <=> root.assist-gestures;
                                    toggled(on) => { root.assist-edited("gestures", on ? 1 : 0); }
                                }
                                Divider { }
                                Row {
                                    label: "Pointer";
                                    Choice { accessible-label: "Headset pointer"; width: 150px; model: ["Eye gaze", "Head", "Left hand", "Right hand"]; current-index <=> root.assist-pointer; selected => { root.assist-edited("pointer", self.current-index); } }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Stop at ledges";
                                    checked <=> root.assist-ledge-brake;
                                    toggled(on) => { root.assist-edited("ledge-brake", on ? 1 : 0); }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Touch controls";
                                    checked <=> root.assist-touch;
                                    toggled(on) => { root.assist-edited("touch", on ? 1 : 0); }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Reduce transparency";
                                    checked <=> root.assist-solid;
                                    toggled(on) => { root.assist-edited("solid", on ? 1 : 0); }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Reduce motion";
                                    checked <=> root.assist-still;
                                    toggled(on) => { root.assist-edited("still", on ? 1 : 0); }
                                }
                            }
                            if root.selected-section == 2: Card {
                                title: "App keys and views";
                                heading: "Global";
                                if root.first-person: ControlRow {
                                    action: "First-person view (in a field)";
                                    inputs: root.first-person-headset ? ["Underhand grab", "Right stick click"] : ["Select", "R3"];
                                }
                                if root.first-person: ControlRow {
                                    action: "Look around in FPV";
                                    inputs: root.first-person-headset ? ["Head", "Right stick"]
                                        : root.mouse-camera
                                        ? (root.first-person-touch ? ["Arrows", "Right stick", "Mouse", "Drag"] : ["Arrows", "Right stick", "Mouse"])
                                        : (root.first-person-touch ? ["Arrows", "Right stick", "Drag"] : ["Arrows", "Right stick"]);
                                }
                                ControlRow { action: "Settings"; inputs: ["Esc", "Back+Start"]; }
                            }
                            // Shortcuts
                            if root.selected-section == 3: Card {
                                title: "App shortcuts";

                                actions := FocusScope {
                                    accessible-role: list;
                                    accessible-label: "App shortcuts";
                                    key-pressed(event) => {
                                        if event.text == Key.UpArrow {
                                            root.select-action(root.selected-action - 1);
                                            return accept;
                                        }
                                        if event.text == Key.DownArrow {
                                            root.select-action(root.selected-action + 1);
                                            return accept;
                                        }
                                        reject
                                    }
                                    VerticalLayout {
                                        spacing: 1px;
                                        for binding[index] in root.bindings: Rectangle {
                                            accessible-role: list-item;
                                            accessible-label: binding.name;
                                            accessible-item-selectable: true;
                                            accessible-item-selected: index == root.selected-action;
                                            accessible-item-index: index;
                                            accessible-action-default => { root.select-action(index); }
                                            border-radius: 7px;
                                            // The open shortcut and its editor are one piece.
                                            background: index == root.selected-action ? Theme.selected : row-touch.pressed ? Theme.pressed : row-touch.has-hover ? Theme.hover : transparent;
                                            border-width: index == root.selected-action ? 1px : 0px;
                                            border-color: Theme.stroke;
                                            animate background { duration: 140ms; easing: ease-out; }
                                            // Beneath the editor's fields and buttons, which take their own presses.
                                            row-touch := TouchArea {
                                                mouse-cursor: index == root.selected-action ? MouseCursor.default : MouseCursor.pointer;
                                                clicked => { root.select-action(index); }
                                            }
                                            VerticalLayout {
                                                HorizontalLayout {
                                                    min-height: 32px;
                                                    padding-left: 10px;
                                                    padding-right: 8px;
                                                    spacing: 6px;
                                                    Text {
                                                        text: binding.name;
                                                        font-size: 12.5px;
                                                        font-weight: index == root.selected-action ? 600 : 400;
                                                        color: index == root.selected-action || row-touch.has-hover ? Theme.text : Theme.text-secondary;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                        animate color { duration: 140ms; }
                                                    }
                                                    VerticalLayout { alignment: center; Keycap { text: binding.keyboard; } }
                                                    VerticalLayout { alignment: center; Keycap { text: binding.gamepad; } }
                                                }
                                                if index == root.selected-action: VerticalLayout {
                                                    padding: 10px;
                                                    padding-top: 2px;
                                                    spacing: 8px;
                                                    Divider { }
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Text { text: "Keys"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 54px; horizontal-stretch: 0; }
                                                        LineEdit {
                                                            accessible-label: "Keyboard binding";
                                                            text <=> root.keyboard-binding;
                                                            changed has-focus => { root.keyboard-editor-focused = self.has-focus; }
                                                            accepted => { root.binding-edited(root.selected-action, root.keyboard-binding, root.gamepad-binding); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        Text { text: "Buttons"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 54px; horizontal-stretch: 0; }
                                                        LineEdit {
                                                            accessible-label: "Gamepad binding";
                                                            text <=> root.gamepad-binding;
                                                            changed has-focus => { root.gamepad-editor-focused = self.has-focus; }
                                                            accepted => { root.binding-edited(root.selected-action, root.keyboard-binding, root.gamepad-binding); }
                                                        }
                                                    }
                                                    HorizontalLayout {
                                                        spacing: 8px;
                                                        alignment: end;
                                                        Button { text: "Cancel"; clicked => { root.select-action(-1); } }
                                                        Button { text: "Clear"; clicked => { root.binding-edited(root.selected-action, "", ""); } }
                                                        Button { text: "Save shortcut"; primary: true; clicked => { root.binding-edited(root.selected-action, root.keyboard-binding, root.gamepad-binding); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Time
                            if root.selected-section == 4: Card {
                                title: "Rewind";
                                heading: "Rewind";

                                ToggleRow {
                                    label: "Rewind history";
                                    checked <=> root.rewind-enabled;
                                    toggled(on) => { root.rewind-enabled-edited(on); }
                                }
                                Divider { }
                                Row {
                                    label: "Interval";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SpinBox {
                                            accessible-label: "Rewind interval in seconds";
                                            width: 104px;
                                            minimum: 1;
                                            maximum: min(root.rewind-interval-max, root.rewind-history-seconds);
                                            value <=> root.rewind-interval-seconds;
                                            edited(value) => { root.rewind-interval-edited(value); }
                                            changed has-focus => { root.rewind-interval-focused = self.has-focus; }
                                        }
                                        Text { text: "s"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 12px; }
                                    }
                                }
                                Divider { }
                                Row {
                                    label: "History length";
                                    HorizontalLayout {
                                        spacing: 8px;
                                        SpinBox {
                                            accessible-label: "Rewind history length in seconds";
                                            width: 104px;
                                            minimum: root.rewind-interval-seconds;
                                            maximum: root.rewind-history-max;
                                            value <=> root.rewind-history-seconds;
                                            edited(value) => { root.rewind-history-edited(value); }
                                            changed has-focus => { root.rewind-history-focused = self.has-focus; }
                                        }
                                        Text { text: "s"; font-size: 12px; color: Theme.text-secondary; vertical-alignment: center; min-width: 12px; }
                                    }
                                }
                                Divider { }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: root.time-status; font-size: 11.5px; color: Theme.text-secondary; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        Button { text: "Hold to rewind"; changed pressed => { root.rewind-held(self.pressed); } }
                                    }
                                }
                            }
                            if root.selected-section == 4: Card {
                                title: "Fast-forward";
                                heading: "Fast-Forward";

                                // An action, not a setting (the bindings'
                                // Toggle fast-forward), for touch screens and
                                // headsets without a keyboard or a gamepad.
                                HorizontalLayout {
                                    alignment: end;
                                    Button { text: root.fast-forward ? "Stop fast-forward" : "Start fast-forward"; clicked => { root.app-action-requested(4); } }
                                }
                                Divider { }
                                SliderRow {
                                    label: "Speed";
                                    value-text: root.fast-forward-rates[root.fast-forward-rate];
                                    Slider {
                                        accessible-label: "Fast-forward rate";
                                        minimum: 0;
                                        maximum: root.fast-forward-rates.length - 1;
                                        step: 1;
                                        value <=> root.fast-forward-position;
                                        changed(value) => {
                                            root.fast-forward-position = round(value);
                                            if round(value) != root.fast-forward-rate {
                                                root.fast-forward-rate-edited(round(value));
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 7px;
                                    for index in root.fast-forward-rates.length: Rectangle {
                                        x: 10px + index * (parent.width - 20px) / (root.fast-forward-rates.length - 1) - 0.5px;
                                        width: 1px;
                                        height: index == root.fast-forward-rate ? 7px : 4px;
                                        background: index == root.fast-forward-rate ? Theme.accent : Theme.text-tertiary;
                                    }
                                }
                                Rectangle {
                                    height: self.width < 380px ? 34px : 16px;
                                    for label[index] in root.fast-forward-rates: Text {
                                        width: label == "Uncapped" ? 58px : 30px;
                                        height: 16px;
                                        y: parent.width < 380px ? (index - 2 * floor(index / 2)) * 18px : 0px;
                                        x: clamp(10px + index * (parent.width - 20px) / (root.fast-forward-rates.length - 1) - self.width / 2, 0px, parent.width - self.width);
                                        text: label;
                                        horizontal-alignment: center;
                                        font-size: 11px;
                                        color: index == root.fast-forward-rate ? Theme.text : Theme.text-tertiary;
                                    }
                                }
                            }
                            if root.selected-section == 4: Card {
                                title: "Pause";
                                ToggleRow {
                                    label: "Pause when the window loses focus";
                                    checked <=> root.pause-on-focus-loss;
                                    toggled(on) => { root.pause-on-focus-loss-edited(on); }
                                }
                            }

                            // Saves
                            // The disc first: what a first run needs.
                            if root.selected-section == 5 && root.can-import-disc: Card {
                                title: "Game disc";
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text { text: root.disc-status; font-size: 12.5px; color: Theme.text-secondary; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        Button { text: "Import disc…"; clicked => { root.import-disc-requested(); } }
                                    }
                                }
                            }

                            if root.selected-section == 5: Card {
                                title: "Save states";

                                HorizontalLayout {
                                    spacing: 8px;
                                    Button { text: "Save state"; primary: true; clicked => { root.app-action-requested(0); } }
                                    Button { text: "Load state"; clicked => { root.app-action-requested(1); } }
                                }
                            }
                            if root.selected-section == 5: Card {
                                title: "Backups";

                                VerticalLayout {
                                    spacing: 8px;
                                    for row in ceil(root.backup-actions.length / root.backup-columns): HorizontalLayout {
                                        spacing: 8px;
                                        Button { text: root.backup-actions[row * root.backup-columns]; horizontal-stretch: 1; preferred-width: 0px; clicked => { root.backup-action-requested(row * root.backup-columns); } }
                                        if root.backup-columns == 2 && row * 2 + 1 < root.backup-actions.length: Button { text: root.backup-actions[row * 2 + 1]; horizontal-stretch: 1; preferred-width: 0px; clicked => { root.backup-action-requested(row * 2 + 1); } }
                                        if root.backup-columns == 2 && row * 2 + 1 >= root.backup-actions.length: Rectangle { horizontal-stretch: 1; preferred-width: 0px; }
                                    }
                                }
                                if root.storage-status != "": Text { text: root.storage-status; font-size: 11.5px; color: Theme.text-secondary; wrap: word-wrap; }
                            }
                            // Gameplay
                            if root.selected-section == 6: Card {
                                title: "Battles";
                                Row {
                                    label: "Random battles";
                                    Segmented { accessible-label: "Random battles"; options: ["Not while platforming", "Original"]; current <=> root.random-battles; selected(index) => { root.random-battles-edited(index); } }
                                }
                                Divider { }
                                Row {
                                    label: "Encounter rate";
                                    Segmented { accessible-label: "Encounter rate"; options: ["Original", "Half"]; current <=> root.encounter-rate; selected(index) => { root.gameplay-edited("encounter-rate", index); } }
                                }
                            }
                            if root.selected-section == 6: Card {
                                title: "Dialogue and movies";
                                Row {
                                    label: "Text speed";
                                    Segmented { accessible-label: "Text speed"; options: ["Original", "Fast", "Instant"]; current <=> root.text-speed; selected(index) => { root.gameplay-edited("text-speed", index); } }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Auto-advance dialogue";
                                    checked <=> root.auto-advance;
                                    toggled(on) => { root.gameplay-edited("auto-advance", on ? 1 : 0); }
                                }
                                if root.auto-advance: SliderRow {
                                    label: "Wait on each page";
                                    value-text: "\{root.auto-advance-dwell / 60} s";
                                    Slider {
                                        accessible-label: "Auto-advance wait on each page";
                                        minimum: 30;
                                        maximum: 600;
                                        value: root.auto-advance-dwell;
                                        changed(value) => { root.gameplay-edited("auto-advance-dwell", round(value / 15) * 15); }
                                    }
                                }
                                Divider { }
                                ToggleRow {
                                    label: "Movies can be skipped";
                                    checked <=> root.movie-skip;
                                    toggled(on) => { root.gameplay-edited("movie-skip", on ? 1 : 0); }
                                }
                            }
                            // The original kernel menu, with application controls.
                            if root.selected-section == 7: Card {
                                title: "Kernel menu";
                                heading: "Kernel menu";
                                Text { text: "Starting a test restarts the game with the selected setup. Save your progress first."; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                                if root.debug-status != "": Text { text: root.debug-status; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                            }
                            if root.selected-section == 7: Card {
                                title: "Field";
                                heading: "Field";
                                Row { label: "Map"; SpinBox { accessible-label: "Debug field map"; minimum: 0; maximum: 1023; value <=> root.debug-map; } }
                                Row { label: "Entrance"; SpinBox { accessible-label: "Debug field entrance"; minimum: 0; maximum: 65535; value <=> root.debug-entry; } }
                                Button { text: "Go to developer room"; enabled: root.debug-available && !root.debug-busy; clicked => { root.debug-requested(6); } }
                                Button { text: "Start field test"; enabled: root.debug-available && !root.debug-busy; clicked => { root.debug-requested(0); } }
                            }
                            if root.selected-section == 7: Card {
                                title: "Battle";
                                heading: "Battle";
                                Row { label: "Formation"; SpinBox { accessible-label: "Debug battle formation"; minimum: 0; maximum: 15; value <=> root.debug-formation; } }
                                Row { label: "File"; SpinBox { accessible-label: "Debug battle file"; minimum: 0; maximum: 255; value <=> root.debug-battle-file; } }
                                Text { text: "Files 253, 254 and 255 select Event 3, Event 2 and Event 1."; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                                for slot in 3: VerticalLayout {
                                    spacing: 6px;
                                    Row {
                                        label: "Party member \{slot + 1}";
                                        Choice { accessible-label: "Debug party member \{slot + 1}"; model: ["Fei", "Elly", "Citan", "Bart", "Billy", "Rico", "Emeralda", "Chu-Chu", "Maria", "Citan (sword)", "Emeralda (adult)", "None"]; current-index: root.debug-party[slot]; selected => { root.debug-party[slot] = self.current-index; } }
                                    }
                                    Row {
                                        label: "Gear \{slot + 1}";
                                        Choice { accessible-label: "Debug Gear \{slot + 1}"; model: ["Off", "Normal", "Bar"]; current-index: root.debug-gears[slot]; selected => { root.debug-gears[slot] = self.current-index; } }
                                    }
                                }
                                Button { text: "Start battle test"; enabled: root.debug-available && !root.debug-busy; clicked => { root.debug-requested(1); } }
                            }
                            if root.selected-section == 7: Card {
                                title: "Worldmap";
                                heading: "Worldmap";
                                Row { label: "Map"; SpinBox { accessible-label: "Debug world map"; minimum: 1024; maximum: 2047; value <=> root.debug-worldmap; } }
                                Button { text: "Start world map test"; enabled: root.debug-available && !root.debug-busy; clicked => { root.debug-requested(2); } }
                            }
                            if root.selected-section == 7: Card {
                                title: "Battling";
                                heading: "Battling";
                                Button { text: "Start Battling"; enabled: root.debug-available && !root.debug-busy; clicked => { root.debug-requested(3); } }
                            }
                            if root.selected-section == 7: Card {
                                title: "Menu";
                                heading: "Menu";
                                Row {
                                    label: "Screen";
                                    Choice { accessible-label: "Debug menu screen"; model: ["Normal menu", "Member change", "Load game", "Enter name", "Item shop", "Gear shop", "Disc change"]; current-index <=> root.debug-menu; selected => { root.debug-parameter = 0; } }
                                }
                                Row {
                                    label: root.debug-menu < 4 ? "Character / Gear" : root.debug-menu == 6 ? "Disc" : "Shop";
                                    SpinBox { accessible-label: "Debug menu parameter"; minimum: 0; maximum: root.debug-menu < 4 ? 30 : root.debug-menu == 6 ? 1 : 255; value <=> root.debug-parameter; }
                                }
                                Button { text: "Open test menu"; enabled: root.debug-available && !root.debug-busy; clicked => { root.debug-requested(4); } }
                            }
                            if root.selected-section == 7: Card {
                                title: "Movie";
                                heading: "Movie";
                                Row { label: "Movie"; SpinBox { accessible-label: "Debug movie number"; minimum: 0; maximum: 63; value <=> root.debug-movie; } }
                                Row { label: "Type"; Choice { accessible-label: "Debug movie type"; model: ["Picture", "Picture and audio", "Audio"]; current-index <=> root.debug-movie-kind; } }
                                Button { text: "Play test movie"; enabled: root.debug-available && !root.debug-busy; clicked => { root.debug-requested(5); } }
                            }
                            // About
                            if root.selected-section == 8: Card {
                                title: "Xenogears Ex Machina";
                                Text { text: "Plays Xenogears from your own discs through its recovered original program. Your discs, saves and settings stay on this device."; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                                Divider { }
                                Row {
                                    label: "Version";
                                    Text { text: root.version; font-size: 13px; color: Theme.text-secondary; }
                                }
                            }
                            if root.selected-section == 8: Card {
                                title: "Save titles";
                                Text { text: "The game draws save titles with your console's BIOS font. Without your BIOS image they use substitute letters, digits and marks drawn for this project, and other characters stay blank. Saves → Import BIOS (save titles) gives the original font."; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                            }
                            if root.selected-section == 8: Card {
                                title: "Built with Slint";
                                Text { text: "Its interface toolkit, under the Slint Royalty-free License 2.0."; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                                AboutSlint { max-height: 120px; }
                            }
                            if root.selected-section == 8: Card {
                                title: "Binaural sound";
                                Text { text: "Places sounds with the MIT Media Lab's KEMAR head-related transfer functions: B. Gardner and K. Martin, \"HRTF Measurements of a KEMAR Dummy-Head Microphone\", MIT Media Lab, 1994. Copyright 1994 MIT Media Laboratory, provided free with no restrictions on use."; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                            }
                        }
                    }
                }
            }
            // The error bar, only while something failed.
            if root.error != "": Rectangle {
                min-height: error-bar.min-height;
                background: Theme.bad.with-alpha(0.08);
                accessible-role: groupbox;
                accessible-label: "Error";
                Rectangle {
                    y: 0px;
                    height: 1px;
                    background: Theme.bad.with-alpha(0.3);
                }
                error-bar := HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 8px;
                    padding-top: 5px;
                    padding-bottom: 5px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon { width: 15px; height: 15px; data: Icons.alert; color: Theme.bad; stroke-width: 1.9px; }
                    }
                    Text {
                        text: root.error;
                        font-size: 12px;
                        color: Theme.bad;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton { icon: Icons.close; label: "Dismiss"; clicked => { root.error = ""; } }
                    }
                }
            }
        }
        if root.quit-confirming: QuitDialog {
            width: parent.width;
            height: parent.height;
            cancelled => { root.quit-confirming = false; }
            confirmed => {
                root.quit-confirming = false;
                root.quit-requested();
            }
        }
    }
}

// One treatment for every element of the HUD over the game: a dark chip
// of one height, border and radius, its symbol a plain icon coloured by
// what it says and its words one weight of text. A failure keeps the
// chip and grows downward to give its cause.
component HudChip inherits Rectangle {
    height: 32px;
    background: #14171cf0;
    border-radius: 8px;
    border-width: 1px;
    border-color: #ffffff24;
}

component HudText inherits Text {
    color: Theme.text;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: center;
}

component HudIcon inherits Icon {
    width: 16px;
    height: 16px;
    color: Theme.text;
}

export component FrameRateOverlay inherits Window {
    in property <string> counter: "— FPS";
    in property <bool> show-fps;
    in property <bool> fast-forward;
    in property <bool> rewinding;
    in property <string> notice;
    in property <bool> notice-error;
    in property <string> notice-title;
    in property <string> notice-detail;
    background: transparent;
    preferred-width: 304px;
    preferred-height: 110px;
    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 32px;
        alignment: start;
        spacing: 6px;
        if root.show-fps: HudChip {
            width: 88px;
            HudText {
                text: root.counter;
                // Steady digits: the counter changes every second.
                font-family: "monospace";
                horizontal-alignment: center;
            }
        }
        if root.fast-forward: HudChip {
            width: 32px;
            accessible-role: text;
            accessible-label: "Fast-forwarding";
            HudIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: "M3 5 L11 12 L3 19 Z M13 5 L21 12 L13 19 Z";
            }
        }
        if root.rewinding: HudChip {
            width: 32px;
            accessible-role: text;
            accessible-label: "Rewinding";
            HudIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                data: "M11 5 L3 12 L11 19 Z M21 5 L13 12 L21 19 Z";
            }
        }
    }
    if root.notice != "": HudChip {
        x: 0px;
        y: root.show-fps || root.fast-forward || root.rewinding ? 38px : 0px;
        width: root.notice-error ? parent.width : min(parent.width, line.preferred-width);
        height: root.notice-error ? 72px : 32px;
        accessible-role: text;
        accessible-label: root.notice;
        line := HorizontalLayout {
            y: 0px;
            height: 32px;
            padding-left: 10px;
            padding-right: 12px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                HudIcon {
                    data: root.notice-error ? Icons.alert : Icons.check;
                    color: root.notice-error ? Theme.bad : Theme.good;
                }
            }
            HudText {
                text: root.notice-title;
                overflow: elide;
                accessible-role: none;
            }
        }
        if root.notice-error: Text {
            x: 34px;
            y: 30px;
            width: parent.width - 46px;
            height: 34px;
            text: root.notice-detail;
            color: Theme.text-secondary;
            font-size: 12px;
            wrap: word-wrap;
            overflow: elide;
            accessible-role: none;
        }
    }
}
