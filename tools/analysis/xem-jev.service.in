# Administrator-installed template. Replace @PYTHON@, @AGENT_UID@ and @AGENT_GROUP@.
# Never run from a writable checkout; review docs/jev.md before installing.
[Unit]
Description=Restricted TypeSafe Jev ranking broker
After=network.target

[Service]
Type=simple
User=xem-jev
Group=@AGENT_GROUP@
ExecStart=@PYTHON@ -I /opt/xem-jev/jev_broker.py --allowed-uid @AGENT_UID@
LoadCredential=typesafe:/etc/xem-jev/typesafe.key
RuntimeDirectory=xem-jev
RuntimeDirectoryMode=0750
UMask=0117
WorkingDirectory=/opt/xem-jev
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
MemoryMax=128M
TasksMax=8
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
