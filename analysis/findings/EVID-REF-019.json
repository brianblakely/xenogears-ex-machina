  "observation": "Two guarded original captures compare 16422 integer normalizations, including 79 zero vectors, 3688 height/normal calculations, 1334 successful point-location queries across three collision layers, and 520 second-normalization actor stores. Each height input matches a source mesh triangle. Lookup parameters, results, pointers and return sites match. The traversal trace reads 15600 scratchpad ranges without modifying the original run.",
  "interpretation": "The original height helper normalizes two triangle edges and takes their Q12 cross product. A later actor update normalizes that result again before storing the floor normal. Zero-vector normalization reads an earlier halfword but returns zero. Point location uses original triangle order and signed packed-coordinate edge tests. These functions recover a collision arithmetic subset, not the full movement controller.",
  "confidence": "supported",
  "validation": {
    "preconditions": [
      "Use the exact selected Disc 1 source and pinned Nix tools. Original payload remains private; the public reconstruction contains no original table.",
      "Use the API 2 observation-trace shell for scratchpad ranges. Keep the guarded field adapter and ordinary route inputs distinct from native gameplay."
    ],
    "commands": [
      "nix --extra-experimental-features 'nix-command flakes' develop path:./nix#observation-trace",
      "python tools/analysis/verify_collision_math.py prepare --raw .local/references/source-1/disc.bin --profile na-slus-00664-39c547a9afc6 --map 23 --start 4300 --end 5600 --output <new-private-spec>",
      "python tools/reference/scenario.py tests/reference-inputs/field23-ramp-observation.json --content \"discs/Xenogears disc 1.chd\" --trace-instructions <spec> --output <new-private-run>",
      "python tools/analysis/verify_collision_math.py compare --raw .local/references/source-1/disc.bin --profile na-slus-00664-39c547a9afc6 --map 23 --start 4300 --end 5600 --capture <run>/capture --output <new-private-comparison>",
      "Repeat for initialization [508,650), using tests/reference-inputs/field23-entry-dialogue.json.",
      "python -m unittest tests.test_collision_math tests.test_instruction_trace",
      "env PYTHONPATH=. python .local/analysis/phase1-field-control-20260908/audit-v1.py (use fresh output names when reproducing)"
    ],
    "expected": "Exact source-qualified arithmetic, memory regions, pointer/return correlations and complete unchanged control artifacts. Reject altered original inputs.",
    "actual": "Both original comparisons pass with zero guard mismatches, unavailable ranges, budget exhaustion or trace errors. All 22 deliberately corrupted original traces are rejected. The two captures match their controls in every RAM snapshot, image, audio file and serialized external state. Eight synthetic arithmetic tests and ten observation-tool tests pass.",
    "result": "passed",
    "tolerance": "Exact integer results, complete sampled point/normal bytes, source tables, memory-space identities and correlated calls. No floating tolerance or output masks. No-match normal clearing, hardware flags/exceptions and full movement remain outside scope.",
