{
  "schema_version": 1,
  "contract_version": "0.1.0",
  "implementation_status": "specified_not_implemented",
  "scope": "Phase 0 source/build/runtime and untrusted-build requirements; dependency qualification is not SDK or native execution.",
  "authoritative_sources": ["typescript", "explicit_json_parameters", "lua_modules", "source_assets"],
  "derived_outputs": ["world_ir", "normalized_meshes", "collision_data", "event_instructions", "glb_assets", "content_package", "source_maps", "build_report"],
  "source_identity": {
    "stable_ids": ["namespace", "component", "instance", "operation", "anchor", "semantic_region", "event"],
    "distinct_revisions": ["source_revision", "input_graph_hash", "package_hash", "runtime_session_id", "snapshot_id", "harness_hash"],
    "identity_must_not_depend_on": ["display_name", "file_path", "triangle_index", "ps1_address"],
    "arbitrary_typescript_roundtrip": false,
    "tsx_status": "deferred_until_function_sdk_parity"
  },
  "stages": [
    {"id": "resolve", "input": "immutable source revision and pinned closure", "output": "complete hashed input graph", "failure": "dependency_or_reference_error"},
    {"id": "parameters", "input": "strict JSON parameters and declared schema", "output": "validated explicit parameters", "failure": "parameter_error"},
    {"id": "typecheck", "input": "TypeScript and SDK declarations", "output": "tsc --noEmit diagnostics", "failure": "type_error"},
    {"id": "transpile", "input": "typechecked TypeScript", "output": "esbuild ESM artifact and source map", "failure": "transpile_error"},
    {"id": "execute", "input": "compiled generator, explicit seed and read-only inputs", "output": "typed world and geometry definitions", "failure": "generator_error"},
    {"id": "normalize", "input": "adapter output", "output": "project-owned mesh and object data", "failure": "geometry_error"},
    {"id": "validate", "input": "world, collision and event definitions", "output": "reference- and capability-checked content", "failure": "content_error"},
    {"id": "export", "input": "validated content", "output": "GLB and versioned JSON manifests", "failure": "export_error"},
    {"id": "verify_package", "input": "candidate package", "output": "revalidated immutable artifact and hashes", "failure": "package_error"},
    {"id": "publish", "input": "verified package", "output": "atomic package revision", "failure": "publication_error"}
  ],
  "project_owned_boundaries": ["sdk", "mesh_adapters", "world_ir", "collision_compiler", "event_compiler", "package_writer", "native_loader", "runtime_services", "source_maps", "edit_transactions", "verification_service"],
  "geometry": {
    "kinds": ["manifold_solid", "open_surface", "arbitrary_mesh", "imported_model"],
    "normalized_attributes": ["positions", "indices", "normals", "uvs", "material_groups", "bounds", "source_attribution"],
    "coordinates": {"handedness": "right", "units": "metres", "up": "+Y", "right": "+X", "forward": "-Z", "angles": "radians", "vectors": "column", "transform_order": ["scale", "rotation", "translation"], "outward_winding": "counterclockwise"},
    "original_collision_conversion": "unrecovered_requires_explicit_evidence_qualified_adapter",
    "collision_modes": ["supported_static_surfaces", "composed_primitives", "separate_simplified_geometry", "none"],
    "validation": ["finite_attributes", "index_bounds", "attribute_cardinality", "degeneracy", "winding", "solid_operand_topology", "material_regions", "resource_budgets", "normal_transform", "unit_conversion", "source_attribution"],
    "validity_domains": ["build", "native_collision_and_traversal", "presentation"]
  },
  "parameters": {
    "schema_dialect": "https://json-schema.org/draft/2020-12/schema",
    "unknown_fields": "reject",
    "coercion": false,
    "unrepresentable_schema": "reject",
    "serializable_subset": ["null", "boolean", "finite_number", "safe_integer", "bounded_string", "bounded_array", "closed_object", "tagged_union", "local_reference"],
    "native_validator_parity_required": true
  },
  "package": {
    "render_assets": "glb_supported_subset",
    "gameplay_manifests": ["world", "collision", "events", "dependencies"],
    "required_identities": ["source_revision", "input_graph_hash", "compiler_version", "engine_compatibility", "schema_versions", "asset_hashes", "source_maps", "package_hash"],
    "original_store": "immutable_local_references_by_verified_id_and_hash",
    "publish": "validate_complete_candidate_then_atomic_replace",
    "failure_retains_previous_package": true,
    "glTF_is_gameplay_contract": false,
    "runtime_requirements": ["native_cpp", "supported_compiled_data", "explicit_lua_when_required"],
    "runtime_forbidden": ["node", "typescript_execution", "javascript_gameplay", "browser", "qt_qml", "authoring_tools", "geometry_kernel", "build_callbacks", "runtime_prompt_interpretation"],
    "headless_uses_same_collision_and_events": true,
    "headless_gpu_allocation": false
  },
  "behavior": {
    "typescript_callbacks_retained": false,
    "ordinary_events": "closed_serializable_native_instructions",
    "custom_behavior": "explicit_lua_api_with_permissions",
    "authoritative_progress": ["instruction", "targets", "wait_conditions", "timeout_ticks", "cancellation", "reward_ownership", "persistent_mod_data"],
    "clock": "native_simulation_ticks",
    "introspection_and_snapshots_required": true
  },
  "service": {
    "transport": "versioned_local_json_rpc_and_cli",
    "mcp": "optional_adapter",
    "capability_states": ["verified", "partial", "opaque_preserved", "unsupported"],
    "surfaces": ["discover", "catalog", "edit", "validate", "build", "launch", "inspect", "trace", "capture", "test", "diff", "package"],
    "edit_guards": ["expected_source_revision", "transaction_id", "dry_run", "atomic_cross_file_validation", "idempotent_retry", "undo"],
    "diagnostic_fields": ["code", "stage", "severity", "source_span", "object_id", "operation_id", "expected", "observed", "reproduction_scenario"],
    "bounded_queries_and_cancellation": true,
    "test_package_is_immutable": true,
    "protected_acceptance_is_writable": false
  },
  "isolation": {
    "status": "required_not_implemented",
    "boundary": "operating_system_or_disposable_vm",
    "unavailable_action": "reject_untrusted_build",
    "error": "isolation_unavailable",
    "plain_node_fallback": false,
    "node_vm_is_security_boundary": false,
    "dependency_acquisition_separate": true,
    "lock_and_integrity_required": true,
    "lifecycle_scripts": "disabled_unless_separate_reviewed_recipe",
    "build_network": false,
    "loopback_network": false,
    "source_mount": "immutable_read_only_snapshot",
    "dependency_mount": "immutable_read_only_reviewed_closure",
    "writable_mounts": ["private_output", "private_temp"],
    "denied": ["host_home", "credentials", "ambient_environment", "inherited_fds", "ssh_agent", "runtime_control_socket", "container_daemon", "display", "gpu", "undeclared_assets", "original_disc_tree", "shared_tool_writes", "protected_harness_writes"],
    "supervisor_limits": {"wall_ms": 120000, "cpu_seconds": 60, "memory_bytes": 2147483648, "output_bytes": 268435456, "temp_bytes": 536870912, "log_bytes": 1048576, "processes": 16, "open_files": 256},
    "content_can_raise_limits": false,
    "cancellation": "terminate_descendant_tree_close_pipes_discard_candidate",
    "output_revalidation": ["canonical_paths", "no_links", "no_external_uris", "file_allowlist", "declared_hashes", "size_and_expansion_limits", "no_implicit_executable_payload", "atomic_publication"],
    "untrusted_generator_debug_authority": false,
    "untrusted_lua_debug_authority": false,
    "host_qualification_required": ["arch_linux", "windows", "macos"]
  },
  "verification": {
    "runtime_status": "defined",
    "legal_actions_required": true,
    "initial_debug_setup_separate": true,
    "corrective_debug_disqualifies_play": true,
    "acceptance_revision_protected": true,
    "required_modes": ["stepped", "unthrottled"],
    "captures": "optional_native_renderer",
    "statuses": ["passed", "failed", "timed_out", "cancelled", "unsupported"],
    "run_artifacts": ["source_revision", "toolchain_hash", "engine_version", "package_hash", "harness_hash", "seed", "initial_state", "setup_provenance", "ordered_actions", "applied_ticks", "state_hashes", "assertions", "coverage", "diagnostics", "terminal_result", "replay", "optional_captures"],
    "early_gate_ids": ["AUTHOR-BUILD", "AUTHOR-ISOLATION", "AUTHOR-PACKAGE", "AUTHOR-GEOMETRY", "AUTHOR-MINIMAL", "AUTHOR-TWO-ROOM", "AUTHOR-MIXED-ASSETS", "AUTHOR-PLAY", "AUTHOR-REPAIR", "AUTHOR-REVISION", "AUTHOR-EVENT-STATE", "AUTHOR-DELIVERY"],
    "expanded_gate_ids": ["AUTHOR-TOWN", "AUTHOR-EDITORS"]
  }
}
